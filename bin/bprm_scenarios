#!/usr/bin/env ruby
# frozen_string_literal: true

# Snapshot the rpms-ux scenario ids this repo's BPRM-parity tests refer to.
#
#   bin/bprm_scenarios ~/workspace/rpms-ux [--out docs/bprm/scenarios.tsv] [--check]
#
# Reads docs/product-cycle/STORIES.md in an rpms-ux checkout (the stories are
# the abstraction; the browser specs here are the concrete) and writes one
# row per scenario: id, story, workflow, persona, story title, the Given,
# When and Then text, and whether it is retired. The header records the
# rpms-ux commit the snapshot came from, so a stale snapshot is visible and
# CI needs no rpms-ux checkout.
#
# --check regenerates to memory and exits 1 when the committed file differs.
# Output is byte-identical for the same rpms-ux commit: rows are in STORIES.md
# order and nothing time-dependent is written.

require "optparse"

module BprmScenarios
  STORY_HEADING = /^### (S-[A-Z]+-\d+)\s+(.*)$/
  BULLET = /^- \*\*(S-[A-Z]+-\d+\.\d+)\*\* (\(retired \d{4}-\d{2}-\d{2}\) )?Given /
  COLUMNS = %w[scenario story workflow persona title given when then retired].freeze

  module_function

  def snapshot(rpms_ux_dir)
    stories_path = File.join(rpms_ux_dir, "docs", "product-cycle", "STORIES.md")
    raise "no STORIES.md at #{stories_path}" unless File.exist?(stories_path)

    commit = `git -C #{rpms_ux_dir} rev-parse HEAD`.strip
    raise "could not read the rpms-ux commit in #{rpms_ux_dir}" if commit.empty?

    rows = parse(File.read(stories_path))
    header = [
      "# rpms-ux scenarios, from docs/product-cycle/STORIES.md at commit #{commit}",
      "# generated by bin/bprm_scenarios; regenerate after rpms-ux changes, do not edit",
      COLUMNS.join("\t")
    ]
    (header + rows.map { |r| COLUMNS.map { |c| r.fetch(c) }.join("\t") }).join("\n") + "\n"
  end

  def parse(text)
    rows = []
    story = nil
    text.split(/^### /).drop(1).each do |block|
      heading, *body = block.lines
      m = "### #{heading}".match(STORY_HEADING)
      next unless m

      story = { "story" => m[1], "title" => m[2].strip,
                "workflow" => body.join[/\*\*Workflow:\*\* (W\d\d)/, 1].to_s,
                "persona" => body.join[/\*\*Persona:\*\* `([a-z_]+)`/, 1].to_s }
      rows.concat(scenarios_in(body.join, story))
    end
    rows
  end

  def scenarios_in(body, story)
    bullets = body.scan(/^- \*\*S-[A-Z]+-\d+\.\d+\*\*.*?(?=^- \*\*S-|^### |\z)/m)
    bullets.map do |bullet|
      m = bullet.match(BULLET)
      next unless m

      given, rest = clause(bullet.sub(BULLET, ""), /\bWhen\b/)
      when_text, then_text = clause(rest, /\bThen\b/)
      story.merge("scenario" => m[1], "retired" => m[2] ? "yes" : "no",
                  "given" => tidy(given), "when" => tidy(when_text), "then" => tidy(then_text))
    end.compact
  end

  def clause(text, keyword)
    head, tail = text.split(keyword, 2)
    [ head.to_s, tail.to_s ]
  end

  def tidy(text)
    text.gsub(/\s+/, " ").strip.sub(/[,.]\z/, "")
  end
end

if $PROGRAM_NAME == __FILE__
  out = "docs/bprm/scenarios.tsv"
  check = false
  parser = OptionParser.new do |o|
    o.banner = "usage: bin/bprm_scenarios <rpms-ux checkout> [--out FILE] [--check]"
    o.on("--out FILE") { |v| out = v }
    o.on("--check") { check = true }
  end
  parser.parse!
  dir = ARGV.first or abort(parser.banner)

  generated = BprmScenarios.snapshot(dir)
  if check
    current = File.exist?(out) ? File.read(out) : ""
    if current == generated
      puts "#{out}: up to date"
    else
      warn "#{out}: differs from #{dir} (#{generated.lines.count - 3} scenarios now, #{[ current.lines.count - 3, 0 ].max} committed); rerun without --check"
      exit 1
    end
  else
    File.write(out, generated)
    puts "#{out}: #{generated.lines.count - 3} scenarios written"
  end
end
