#!/usr/bin/env ruby
# frozen_string_literal: true

# Generate the pending browser specs for every rpms-ux scenario no driven
# feature covers yet (lakeraven-ehr#565).
#
#   bin/bprm_stubs [--scenarios docs/bprm/scenarios.tsv] [--features features/bprm_twin]
#
# For each BPRM workflow (W01 registration, W02 scheduling, W18 ADT, W19
# benefits) it writes features/bprm_twin/stubs/<workflow>.feature holding one
# scenario per rpms-ux scenario id that is not tagged in any hand-written
# feature under features/bprm_twin/<workflow>/. A scenario becomes real by
# writing it there with the same tag and rerunning this script, which drops
# the stub. Each stub's first step pends naming what it waits on; the story's
# own Given/When/Then follow, quoted, matched by a step that also pends
# (features/step_definitions/bprm_scenario_steps.rb), so nothing here can
# pass silently.

require "optparse"

module BprmStubs
  WORKFLOWS = {
    "W01" => { file: "w01_patient_registration", name: "W01 Patient Registration" },
    "W02" => { file: "w02_scheduling", name: "W02 Scheduling" },
    "W18" => { file: "w18_admission_discharge_transfer", name: "W18 Admission, Discharge and Transfer" },
    "W19" => { file: "w19_benefits_and_eligibility", name: "W19 Benefits and Eligibility" }
  }.freeze
  TAG = /@(S-[A-Z]+-\d+\.\d+)\b/

  module_function

  def read_scenarios(path)
    lines = File.readlines(path, chomp: true)
    commit = lines.first[/commit (\h+)/, 1]
    header = lines.find { |l| !l.start_with?("#") }.split("\t")
    rows = lines.reject { |l| l.start_with?("#") }.drop(1).map { |l| header.zip(l.split("\t", -1)).to_h }
    [ commit, rows ]
  end

  def driven_ids(features_dir)
    Dir.glob(File.join(features_dir, "**", "*.feature"))
       .reject { |f| f.include?("/stubs/") }
       .flat_map { |f| File.read(f).scan(TAG).flatten }
  end

  def feature(workflow, rows, commit)
    meta = WORKFLOWS.fetch(workflow)
    out = +"# GENERATED by bin/bprm_stubs from docs/bprm/scenarios.tsv (rpms-ux #{commit}). Do not edit.\n"
    out << "# A scenario leaves this file by being written, with the same tag, in\n"
    out << "# features/bprm_twin/#{workflow.downcase}_*/ and rerunning bin/bprm_stubs.\n"
    out << "@bprm_twin @bprm_stub @#{workflow}\n"
    out << "Feature: #{meta[:name]}: scenarios no lakeraven-ehr screen drives yet\n"
    rows.each { |row| out << "\n" << scenario(row) }
    out
  end

  def scenario(row)
    persona = row["persona"].tr("_", " ")
    <<~GHERKIN.gsub(/^/, "  ")
      @#{row["scenario"]}
      Scenario: #{row["scenario"]} #{row["title"]}
        Given this scenario waits on #{quote("a lakeraven-ehr screen and steps for #{row["story"]} #{row["title"]}")}
        And the #{persona} is signed on
        And #{quote(row["given"])}
        When #{quote(row["when"])}
        Then #{quote(row["then"])}
    GHERKIN
  end

  def quote(text)
    "\"#{text.gsub('"', '\"')}\""
  end
end

if $PROGRAM_NAME == __FILE__
  scenarios = "docs/bprm/scenarios.tsv"
  features = "features/bprm_twin"
  OptionParser.new do |o|
    o.on("--scenarios FILE") { |v| scenarios = v }
    o.on("--features DIR") { |v| features = v }
  end.parse!

  commit, rows = BprmStubs.read_scenarios(scenarios)
  driven = BprmStubs.driven_ids(features)
  Dir.mkdir(File.join(features, "stubs")) unless Dir.exist?(File.join(features, "stubs"))

  BprmStubs::WORKFLOWS.each do |workflow, meta|
    mine = rows.select { |r| r["workflow"] == workflow && r["retired"] == "no" && !driven.include?(r["scenario"]) }
    path = File.join(features, "stubs", "#{meta[:file]}.feature")
    File.write(path, BprmStubs.feature(workflow, mine, commit))
    puts "#{path}: #{mine.size} pending scenario(s)"
  end
end
