<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title).presence || "Consent" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", media: "all" %>
  <%= render "lakeraven/ehr/shared/demo_banner_style" %>
</head>
<body class="lr-ehr min-h-screen bg-slate-50 text-slate-900 antialiased">
  <%= render "lakeraven/ehr/shared/demo_banner" %>
  <main class="mx-auto max-w-3xl px-4 py-6">
    <%= yield %>
  </main>
  <%= render "lakeraven/ehr/shared/consent_kiosk_channel",
        announce: "handover-started",
        blank: true,
        handover_token: (@consent_lock || {})["handover_token"] %>
</body>
</html>
