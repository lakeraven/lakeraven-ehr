<!DOCTYPE html>
<html lang="en">
<head>
  <%# Views set a page-specific title via content_for; the engine name is the
      fallback. A distinct title per page is a basic screen-reader affordance. %>
  <title><%= content_for(:title).presence || "Lakeraven EHR" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%= stylesheet_link_tag    "lakeraven/ehr/application", media: "all" %>
</head>
<body>

<%= yield %>

</body>
</html>
