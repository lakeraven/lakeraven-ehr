<%
  finished = @visit["status"] == "finished"
  fhir_url = "#{patient_visit_summary_path(@dfn, Lakeraven::EHR::DemoVisitsController::DEMO_VISIT_IEN)}.json"
%><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= @patient_name %> — Visit Summary</title>
  <style>
    :root{--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;--brand:#0369a1;--ok:#047857;--ok-bg:#ecfdf5}
    *{box-sizing:border-box} body{margin:0;background:#f1f5f9;color:var(--ink);
      font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
    .wrap{max-width:720px;margin:0 auto;padding:22px 18px 60px} a{color:var(--brand)}
    .top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:4px}
    h1{font-size:22px;margin:0}
    .status{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;border-radius:999px;
      padding:5px 12px;color:var(--ok);background:var(--ok-bg);border:1px solid #a7f3d0}
    .sub{color:var(--muted);margin:0 0 16px;font-size:13.5px}
    .card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:15px 18px;margin:13px 0}
    .card h2{font-size:14px;margin:0 0 10px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
    .vitals{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
    @media(max-width:560px){.vitals{grid-template-columns:repeat(2,1fr)}}
    .vital{border:1px solid var(--line);border-radius:9px;padding:9px 10px;background:#fbfdff}
    .vital .lbl{font-size:10.5px;text-transform:uppercase;color:var(--muted);font-weight:700}
    .vital .val{font-size:19px;font-weight:700;margin-top:2px}
    .vital .val .u{font-size:11px;color:var(--muted);font-weight:500;margin-left:2px}
    .kv{font-size:14.5px} .kv b{font-weight:700}
    .note-body{white-space:pre-wrap;background:#f8fafc;border:1px solid var(--line);border-radius:9px;padding:11px 13px;font-size:13.5px}
    .sig{margin-top:8px;font-size:12.5px;font-weight:700;color:var(--ok)}
    .foot{margin-top:22px;display:flex;gap:16px;align-items:center;font-size:13.5px}
    .fhir{background:var(--brand);color:#fff;text-decoration:none;font-weight:700;border-radius:8px;padding:7px 13px}
  </style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <h1><%= @patient_name %> — Visit Summary</h1>
    <% if finished %><span class="status">Finished</span><% end %>
  </div>
  <p class="sub">Walk-in visit #<%= Lakeraven::EHR::DemoVisitsController::DEMO_VISIT_IEN %> — charted end to end.</p>

  <% if @visit["vitals"].present? %>
    <div class="card"><h2>Vitals</h2>
      <div class="vitals">
        <% @visit["vitals"].each do |m| %>
          <div class="vital"><div class="lbl"><%= m["label"] || m["abbreviation"] %></div>
            <div class="val"><%= m["value"] %><span class="u"><%= m["units"] %></span></div></div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @visit["pov"] %>
    <div class="card"><h2>Purpose of Visit</h2>
      <div class="kv"><b><%= @visit["pov"]["code"] %></b> — <%= @visit["pov"]["narrative"] %></div></div>
  <% end %>

  <% if @visit["note"] %>
    <div class="card"><h2>Progress Note</h2>
      <div class="note-body"><%= @visit["note"]["text"] %></div>
      <% if @visit["note"]["signed"] %><div class="sig">✓ Signed — note #<%= @visit["note"]["note_ien"] %></div><% end %>
    </div>
  <% end %>

  <% if @visit["close"] %>
    <div class="card"><h2>Disposition</h2>
      <div class="kv">Encounter <b>finished</b> — <%= @visit.dig("close", "code") %> <%= @visit.dig("close", "display") %></div></div>
  <% end %>

  <div class="foot">
    <a href="<%= patient_chart_path(@dfn) %>">← Back to chart</a>
    <a href="<%= new_patient_visit_path(@dfn) %>">+ New visit</a>
    <a class="fhir" href="<%= fhir_url %>">View as FHIR →</a>
  </div>
  <p class="sub" style="margin-top:14px">The same visit is available as a FHIR R4 Bundle at this URL with <code>.json</code>.</p>
</div>
</body>
</html>
