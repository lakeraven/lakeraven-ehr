<% content_for :title, "Sign in | Lakeraven EHR" %>

<div class="mx-auto mt-8 max-w-sm">
  <div class="card">
    <h1>Sign in</h1>
    <p class="text-sm text-slate-600">
      Use your RPMS access and verify codes.
    </p>

    <% if flash[:alert] %>
      <p
        role="alert"
        class="alert alert--error"
      ><%= flash[:alert] %></p>
    <% elsif flash[:notice] %>
      <p
        role="status"
        class="alert alert--notice"
      ><%= flash[:notice] %></p>
    <% end %>

    <%# Real RPMS sign-on (#332). The access/verify pair is validated against the
        broker; the field is named `username` for form convention but it carries
        the VistA ACCESS CODE, which is why the engine filters it from logs. %>
    <%= form_with url: login_path, method: :post, local: true, class: "mt-6 space-y-4" do |f| %>
      <div class="space-y-1">
        <label for="username">Access code</label>
        <input
          type="password"
          name="username"
          id="username"
          autocomplete="username"
        />
      </div>
      <div class="space-y-1">
        <label for="password">Verify code</label>
        <input
          type="password"
          name="password"
          id="password"
          autocomplete="current-password"
        />
      </div>
      <button
        type="submit"
        class="w-full"
      >Sign in</button>
    <% end %>
  </div>
</div>
