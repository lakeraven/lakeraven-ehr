<% content_for :title, "Sign in | Lakeraven EHR" %>

<h1>Sign in</h1>

<% if flash.now[:alert] || flash[:alert] %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>

<%# Real RPMS sign-on (#332). The access/verify pair is validated against the
    broker; the field is named `username` for form convention but it carries
    the VistA ACCESS CODE, which is why the engine filters it from logs. %>
<%= form_with url: login_path, method: :post, local: true do |f| %>
  <div>
    <label for="username">Access code</label>
    <input type="password" name="username" id="username" autocomplete="username" />
  </div>
  <div>
    <label for="password">Verify code</label>
    <input type="password" name="password" id="password" autocomplete="current-password" />
  </div>
  <button type="submit">Sign in</button>
<% end %>
