<% page_title "Dashboard" %>

<% if flash.now[:alert] || flash[:alert] %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>

<%= page_header "Dashboard",
      "Your work for today, counted from RPMS." %>

<% if @notification_count == :unread %>
  <%= alert_box :error,
        "Your notifications could not be read from RPMS.",
        "Try again in a moment.",
        id: "notification-count-unread" %>
<% elsif @notification_count %>
  <section aria-labelledby="notifications-heading">
    <h2 id="notifications-heading">Notifications</h2>
    <p
      id="notification-count"
      data-count="<%= @notification_count %>"
    >
      <%= link_to notifications_path,
            class: "font-semibold tabular-nums" do %>
        <%= @notification_count %>
        <span class="sr-only"><%= "notification".pluralize(@notification_count) %> for you in RPMS</span>
      <% end %>
    </p>
  </section>
<% end %>

<% if @clinic_counts == :unread %>
  <%= alert_box :error,
        "Today's appointments could not be read from RPMS.",
        "Open a clinic's day from Scheduling, or try again in a moment.",
        id: "clinic-counts-unread" %>
<% elsif @clinic_counts %>
  <section aria-labelledby="todays-appointments">
    <h2 id="todays-appointments">Today's appointments</h2>
    <% if @clinic_counts.empty? %>
      <%= empty_state "No clinic resources are open to you.",
            "Your site manager can give you access to a clinic.",
            id: "no-clinics" %>
    <% else %>
      <table
        id="clinic-counts"
        class="data-table"
      >
        <caption class="sr-only">
          Appointments today, <%= @today.strftime("%A, %b %-d, %Y") %>, in each of your clinics.
          Cancelled appointments and no-shows are not counted.
        </caption>
        <thead>
          <tr>
            <th scope="col">Clinic</th>
            <th scope="col">Appointments</th>
          </tr>
        </thead>
        <tbody>
          <% @clinic_counts.each do |row| %>
            <tr data-resource="<%= row[:resource][:id] %>">
              <th scope="row"><%= row[:resource][:name] %></th>
              <td data-count="<%= row[:count] %>">
                <%= link_to scheduling_clinic_path(row[:resource][:id], date: @today.iso8601),
                      class: "font-semibold tabular-nums" do %>
                  <%= row[:count] %>
                  <span class="sr-only"><%= "appointment".pluralize(row[:count]) %> today at <%= row[:resource][:name] %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
<% end %>

<% unless @clinic_counts || @notification_count %>
  <%= empty_state "Nothing here counts work for you yet.",
        "Counts appear here as the screens for that work are added.",
        id: "no-counts" %>
<% end %>
