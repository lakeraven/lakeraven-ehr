<%#
  The patient chart (#452). It renders in the engine layout, like every page
  with a patient open: the layout draws the header, the nav and the patient
  banner (shared/_patient_banner), so the chart looks like the rest of the app.
  The banner's allergy alert carries the chart's fuller allergy detail
  (content_for :patient_allergies below), so allergies show once.
  The sections are built from the design-system pieces (docs/DESIGN-SYSTEM.md):
  page_header, alert_box, card, data-table, status_badge and empty_state, with
  no CSS of the chart's own (#1111).
%>
<%
  fhir_url = url_for(dfn: @patient.dfn, format: "json", only_path: true)
%>
<% page_title "Patient chart" %>

<%# ---- The banner's allergy alert, with the chart's detail. A fetch error or
      a withheld list is "Not loaded", never "No Known Allergies". Names that
      passed egress stay in the alert when the list is incomplete;
      AllergyListStatus#text is that sentence for the alert and the detail. ---- %>
<% content_for :patient_allergies do %>
  <span class="patient-banner__allergies-label">
    &#9888;&#xFE0E; Allergies<% if @allergy_list_status.loaded? %> (<%= @allergies.length %>)<% end %>
  </span>
  <% unless @allergy_list_status.loaded? %>
    <span><%= @allergy_list_status.text %></span>
  <% end %>
  <% if @allergy_list_status.loaded? || @allergies.any? %>
    <% @allergies.each do |a| %>
      <span class="allergy-chip">
        <%= a.display_allergen %>
        <% if a.reaction.present? %>
          <span class="font-normal text-slate-600">
            &middot; <%= a.reaction %>
            (<span class="<%= { "severe" => "font-bold text-red-700", "moderate" => "font-bold text-amber-700", "mild" => "font-bold text-blue-700" }[a.severity.to_s.downcase] %>"><%= a.severity %></span>)
          </span>
        <% end %>
      </span>
    <% end %>
  <% end %>
  <% if capability?("allergy.record") %>
    <div class="patient-banner__allergy-actions">
      <%= link_to "Record an allergy",
            new_patient_allergy_path(@patient.dfn),
            class: "button-secondary no-underline" %>
      <%= button_to "No known allergies",
            patient_no_known_allergies_path(@patient.dfn),
            method: :post,
            class: "button-secondary" %>
    </div>
  <% end %>
<% end %>

<%# The page's one h1. The banner names the patient without a heading
    (#1113). The actions are the chart's ways into other flows. %>
<%= page_header "Patient chart" do %>
  <% if screenings_allowed? %>
    <%= link_to "Screenings",
          patient_screenings_path(@patient.dfn),
          class: "button-secondary no-underline" %>
  <% end %>
  <%= link_to "Consents",
        patient_consents_path(@patient.dfn),
        class: "button-secondary no-underline" %>
  <%= link_to "View as FHIR",
        fhir_url,
        class: "button-secondary no-underline" %>
  <% if capability?("visit.chart") %>
    <%= link_to "Take vitals",
          new_patient_vitals_path(@patient.dfn),
          class: "button-secondary no-underline" %>
    <%= link_to "Mark allergies reviewed",
          new_patient_allergy_review_path(@patient.dfn),
          class: "button-secondary no-underline" %>
    <%= link_to "Record chief complaint",
          new_patient_chief_complaint_path(@patient.dfn),
          class: "button-secondary no-underline" %>
  <% end %>
<% end %>

<% if flash[:notice].present? %>
  <%= alert_box :notice, flash[:notice], id: "chart-notice" %>
<% end %>

<div class="grid gap-4 md:grid-cols-2">
  <%# ---- Problem list ---- %>
  <section
    id="chart-problems"
    class="card"
    aria-labelledby="chart-problems-heading"
  >
    <h2
      id="chart-problems-heading"
      class="mt-0"
    >
      Problem list
      <span class="font-normal text-slate-600">(<%= @conditions.length %>)</span>
    </h2>
    <% if @conditions.any? %>
      <table
        id="chart-problems-table"
        class="data-table"
      >
        <caption class="sr-only">Problem list</caption>
        <thead>
          <tr>
            <th scope="col">Problem</th>
            <th scope="col">ICD-10</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @conditions.each do |c| %>
            <% status = c.clinical_status.presence %>
            <tr>
              <td><%= c.display %></td>
              <td class="tabular-nums"><%= c.code %></td>
              <td><%= status_badge status || "unknown", (status || "unknown").upcase_first %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= empty_state "No active problems recorded." %>
    <% end %>
  </section>

  <%# ---- Medications ---- %>
  <section
    id="chart-medications"
    class="card"
    aria-labelledby="chart-medications-heading"
  >
    <h2
      id="chart-medications-heading"
      class="mt-0"
    >
      Medications
      <span class="font-normal text-slate-600">(<%= @medications.length %>)</span>
    </h2>
    <% if @medications.any? %>
      <table
        id="chart-medications-table"
        class="data-table"
      >
        <caption class="sr-only">Medications</caption>
        <thead>
          <tr>
            <th scope="col">Medication</th>
            <th scope="col">Sig</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @medications.each do |m| %>
            <%# The order's status as RPMS reports it (#628); its colour is
                active, unknown, or inactive for any other status. %>
            <% med_status = m.status.presence || "unknown" %>
            <% med_tone = %w[active unknown].include?(med_status) ? med_status : "inactive" %>
            <tr>
              <td><%= m.medication_display %></td>
              <td><%= m.dosage_instruction %></td>
              <td><%= status_badge med_tone, med_status.upcase_first %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= empty_state "No active medications." %>
    <% end %>
  </section>

  <%# ---- Vitals ---- %>
  <section
    id="chart-vitals"
    class="card md:col-span-2"
    aria-labelledby="chart-vitals-heading"
  >
    <h2
      id="chart-vitals-heading"
      class="mt-0"
    >
      Vital signs
      <span class="font-normal text-slate-600">(<%= @vitals.length %>)</span>
    </h2>
    <% if @vitals.any? %>
      <dl class="m-0 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <% @vitals.each do |v| %>
          <div
            class="rounded-md border border-slate-200 px-3 py-2"
            data-vital="<%= v[:type] %>"
          >
            <dt class="text-sm font-semibold text-slate-600"><%= Lakeraven::EHR::Observation.vital_name(v[:type]) %></dt>
            <dd class="m-0 text-xl font-semibold tabular-nums">
              <span data-vital-value><%= v[:value] %></span>
              <span
                class="text-sm font-normal text-slate-600"
                data-vital-unit
              ><%= Lakeraven::EHR::Observation.display_unit(v[:units]) %></span>
            </dd>
          </div>
        <% end %>
      </dl>
    <% else %>
      <%= empty_state "No vitals recorded." %>
    <% end %>
  </section>

  <%# ---- Behavioral health screenings (#474), trended scores ---- %>
  <section
    id="chart-screenings"
    class="card md:col-span-2"
    aria-labelledby="chart-screenings-heading"
  >
    <h2
      id="chart-screenings-heading"
      class="mt-0"
    >
      Behavioral health screenings
      <span class="font-normal text-slate-600">(<%= @screenings.length %>)</span>
    </h2>
    <% if @screenings.any? %>
      <table
        id="chart-screenings-table"
        class="data-table"
      >
        <caption class="sr-only">Behavioral health screenings</caption>
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Instrument</th>
            <th scope="col">Score</th>
            <th scope="col">Severity</th>
          </tr>
        </thead>
        <tbody>
          <% @screenings.each do |s| %>
            <tr>
              <td class="tabular-nums"><%= s.effective_at.strftime("%b %-d, %Y") %></td>
              <td><%= s.instrument.short_title %></td>
              <td class="tabular-nums"><%= s.total_score %> / <%= s.instrument.max_score %></td>
              <%# The badge's key is the WHOLE band ("moderately severe"), never its first word. %>
              <td><%= status_badge s.severity_band, s.severity_band.to_s.upcase_first %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= empty_state "No screenings recorded." %>
    <% end %>
  </section>

  <%# ---- Allergies (detail). The count and the body read AllergyListStatus,
        so a name that passed egress stays in the table when the list is
        incomplete. ---- %>
  <section
    id="chart-allergies"
    class="card"
    aria-labelledby="chart-allergies-heading"
  >
    <h2
      id="chart-allergies-heading"
      class="mt-0"
    >
      Allergies
      <span class="font-normal text-slate-600">(<%= @allergy_list_status.count_label %>)</span>
    </h2>
    <% unless @allergy_list_status.loaded? %>
      <%= empty_state @allergy_list_status.text %>
    <% end %>
    <% if @allergy_list_status.loaded? || @allergies.any? %>
      <table
        id="chart-allergies-table"
        class="data-table"
      >
        <caption class="sr-only">Allergies</caption>
        <thead>
          <tr>
            <th scope="col">Allergen</th>
            <th scope="col">Reaction</th>
            <th scope="col">Severity</th>
          </tr>
        </thead>
        <tbody>
          <% @allergies.each do |a| %>
            <tr>
              <td><%= a.display_allergen %></td>
              <td><%= a.reaction %></td>
              <td>
                <% if a.severity.present? %>
                  <%= status_badge a.severity.to_s.downcase, a.severity.to_s.upcase_first %>
                <% else %>
                  Not recorded
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>

  <%# ---- Immunizations (IHS-only, #647) ---- %>
  <% if feature_available?(:ihs_immunization) %>
    <section
      id="chart-immunizations"
      class="card"
      aria-labelledby="chart-immunizations-heading"
    >
      <h2
        id="chart-immunizations-heading"
        class="mt-0"
      >
        Immunizations
        <% unless @immunizations_load_failed %>
          <span class="font-normal text-slate-600">(<%= @immunizations.length %>)</span>
        <% end %>
      </h2>
      <% if @immunizations_load_failed %>
        <%= empty_state "Immunizations could not be loaded." %>
      <% elsif @immunizations.any? %>
        <table
          id="chart-immunizations-table"
          class="data-table"
        >
          <caption class="sr-only">Immunizations</caption>
          <thead>
            <tr>
              <th scope="col">Vaccine</th>
              <th scope="col">Date</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            <% @immunizations.each do |i| %>
              <tr>
                <td><%= i.vaccine_display %></td>
                <td class="tabular-nums"><%= i.occurrence_datetime&.strftime("%b %-d, %Y") %></td>
                <td><%= status_badge(%w[completed active].include?(i.status) ? "active" : "inactive", i.status.to_s.upcase_first) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <%= empty_state "No immunizations on file." %>
      <% end %>
    </section>
  <% end %>

  <%# ---- Encounters and appointments ---- %>
  <section
    id="chart-encounters"
    class="card md:col-span-2"
    aria-labelledby="chart-encounters-heading"
  >
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2
        id="chart-encounters-heading"
        class="my-0"
      >
        Encounters &amp; Appointments
        <span class="font-normal text-slate-600">(<%= @encounters.length %>)</span>
      </h2>
      <% if @progress_note_link || @demo_visit_link %>
        <div class="form-actions">
          <% if @progress_note_link %>
            <%= link_to "Write note",
                  new_patient_progress_note_path(@patient.dfn),
                  class: "button-primary no-underline" %>
          <% end %>
          <% if @demo_visit_link %>
            <%= link_to "+ New visit",
                  new_patient_visit_path(@patient.dfn),
                  class: "button-secondary no-underline" %>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if @encounters.any? %>
      <table
        id="chart-encounters-table"
        class="data-table"
      >
        <caption class="sr-only">Encounters and appointments</caption>
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Location</th>
            <th scope="col">Class</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @encounters.each do |e| %>
            <tr>
              <td class="tabular-nums"><%= e[:datetime].respond_to?(:strftime) ? e[:datetime].strftime("%b %-d, %Y") : e[:datetime] %></td>
              <td><%= e[:location].presence || "Not recorded" %></td>
              <td>Ambulatory</td>
              <td><%= status_badge e[:status].to_s.downcase, e[:status].to_s.titleize %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= empty_state "No encounters or upcoming appointments." %>
    <% end %>
  </section>
</div>
