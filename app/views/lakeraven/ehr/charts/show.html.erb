<%#
  The patient chart (#452). It renders in the engine layout, like every page
  with a patient open: the layout draws the header, the nav and the patient
  banner (shared/_patient_banner), so the chart looks like the rest of the app.
  The banner's allergy alert carries the chart's fuller allergy detail
  (content_for :patient_allergies below), so allergies show once.
  The sections keep their own CSS, scoped to .chart-page so it cannot restyle
  the header or the banner.
%>
<%
  vital_labels = Lakeraven::EHR::Observation::VITAL_TYPE_MAP
  fhir_url = url_for(dfn: @patient.dfn, format: "json", only_path: true)
%>
<% page_title "Patient chart" %>

<% content_for :head do %>
  <%= tag.style nonce: content_security_policy_nonce do %>
    .chart-page{
      /* --muted/--line darkened for projector contrast (washed-out rooms) */
      --ink:#0f172a; --muted:#475569; --line:#cbd5e1;
      --card:#ffffff; --brand:#0e5a8a; --brand-dark:#0b4a72;
      --danger:#b91c1c; --danger-bg:#fef2f2;
      --ok:#047857; --ok-bg:#ecfdf5; --warn:#b45309; --warn-bg:#fffbeb;
      color:var(--ink);font-size:15px;line-height:1.5}

    .chart-page .flash.notice{color:var(--ok);background:var(--ok-bg);border:1px solid #a7f3d0;
      border-radius:10px;padding:10px 14px;margin:0 0 12px;font-weight:600}

    /* Grid + cards */
    .chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
    @media(max-width:820px){.chart-grid{grid-template-columns:1fr}}
    .chart-card{background:var(--card);border:1px solid var(--line);border-radius:12px;
      box-shadow:0 1px 2px rgba(15,23,42,.04);overflow:hidden}
    .chart-card.span{grid-column:1 / -1}
    .chart-card__head{display:flex;align-items:center;justify-content:space-between;
      padding:13px 16px;border-bottom:1px solid var(--line);background:#fbfdff}
    .chart-card__head h2{margin:0;font-size:14.5px;font-weight:700;letter-spacing:.2px}
    .chart-page .count{background:#eef4f9;color:var(--brand-dark);border-radius:999px;padding:2px 9px;
      font-size:12px;font-weight:700;font-variant-numeric:tabular-nums}
    .chart-card__body{padding:6px 16px 14px}

    .chart-page table{width:100%;border-collapse:collapse}
    .chart-page th,.chart-page td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--line);vertical-align:top}
    .chart-page th{font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:700}
    .chart-page td{font-size:14px}
    .chart-page tbody tr:nth-child(even) td{background:#f8fafc}
    .chart-page tr:last-child td{border-bottom:none}
    .chart-page .mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12.5px;color:var(--muted)}

    .chart-page .badge{display:inline-block;border-radius:999px;padding:2px 9px;font-size:11px;font-weight:700;
      text-transform:capitalize}
    .chart-page .badge.active{background:var(--ok-bg);color:var(--ok)}
    .chart-page .badge.inactive,.chart-page .badge.unknown{background:#f1f5f9;color:var(--muted)}
    .chart-page .badge.sev-severe{background:var(--danger-bg);color:var(--danger)}
    .chart-page .badge.sev-moderate{background:var(--warn-bg);color:var(--warn)}
    .chart-page .badge.sev-mild{background:#eff6ff;color:#1d4ed8}
    /* Screening severity bands (#474). `sev-moderately-severe` needs its own
       rule: class matching is per-token, so `.sev-moderate` does NOT match it,
       and it must read as distinct from both neighbouring bands. */
    .chart-page .badge.sev-minimal{background:#f1f5f9;color:var(--muted)}
    .chart-page .badge.sev-moderately-severe{background:#ffedd5;color:#c2410c}
    .chart-page .empty{color:var(--muted);font-size:13px;padding:10px 2px;margin:0}

    .chart-page .vitals{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:8px 2px}
    @media(max-width:640px){.chart-page .vitals{grid-template-columns:repeat(2,1fr)}}
    .chart-page .vital{border:1px solid var(--line);border-radius:10px;padding:11px 12px;background:#fbfdff}
    .chart-page .vital .lbl{font-size:11.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:700}
    .chart-page .vital .val{font-size:23px;font-weight:700;margin-top:3px;font-variant-numeric:tabular-nums}
    .chart-page .vital .val .u{font-size:12px;color:var(--muted);font-weight:500;margin-left:3px}

  <% end %>
<% end %>

<%# ---- The banner's allergy alert, with the chart's detail. A fetch error or
      a withheld list is "Not loaded", never "No Known Allergies". Names that
      passed egress stay in the alert when the list is incomplete;
      AllergyListStatus#text is that sentence for the alert and the detail. ---- %>
<% content_for :patient_allergies do %>
  <span class="patient-banner__allergies-label">
    &#9888;&#xFE0E; Allergies<% if @allergy_list_status.loaded? %> (<%= @allergies.length %>)<% end %>
  </span>
  <% unless @allergy_list_status.loaded? %>
    <span><%= @allergy_list_status.text %></span>
  <% end %>
  <% if @allergy_list_status.loaded? || @allergies.any? %>
    <% @allergies.each do |a| %>
      <span class="allergy-chip">
        <%= a.display_allergen %>
        <% if a.reaction.present? %>
          <span class="font-normal text-slate-600">
            &middot; <%= a.reaction %>
            (<span class="<%= { "severe" => "font-bold text-red-700", "moderate" => "font-bold text-amber-700", "mild" => "font-bold text-blue-700" }[a.severity.to_s.downcase] %>"><%= a.severity %></span>)
          </span>
        <% end %>
      </span>
    <% end %>
  <% end %>
  <div class="patient-banner__allergy-actions">
    <%= link_to "Record an allergy",
          new_patient_allergy_path(@patient.dfn) %>
    <%= button_to "No known allergies",
          patient_no_known_allergies_path(@patient.dfn),
          method: :post %>
  </div>
<% end %>

<div class="chart-page">
  <% if flash[:notice].present? %>
    <p
      class="flash notice"
      role="status"
    >
      <%= flash[:notice] %>
    </p>
  <% end %>

  <div class="form-actions">
    <%= link_to "Consents",
          patient_consents_path(@patient.dfn),
          class: "button-secondary no-underline" %>
    <%= link_to "View as FHIR",
          fhir_url,
          class: "button-secondary no-underline" %>
  </div>

  <div class="chart-grid">
    <%# ---- Problem list ---- %>
    <div class="chart-card">
      <div class="chart-card__head"><h2>Problem List</h2><span class="count"><%= @conditions.length %></span></div>
      <div class="chart-card__body">
        <% if @conditions.any? %>
          <table>
            <thead><tr><th>Problem</th><th>ICD-10</th><th>Status</th></tr></thead>
            <tbody>
              <% @conditions.each do |c| %>
                <tr>
                  <td><%= c.display %></td>
                  <td class="mono"><%= c.code %></td>
                  <td><span class="badge <%= c.clinical_status.presence || "unknown" %>"><%= c.clinical_status.presence || "Unknown" %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="empty">No active problems recorded.</p>
        <% end %>
      </div>
    </div>

    <%# ---- Medications ---- %>
    <div class="chart-card">
      <div class="chart-card__head"><h2>Medications</h2><span class="count"><%= @medications.length %></span></div>
      <div class="chart-card__body">
        <% if @medications.any? %>
          <table>
            <thead><tr><th>Medication</th><th>Sig</th><th>Status</th></tr></thead>
            <tbody>
              <% @medications.each do |m| %>
                <tr>
                  <td><%= m.medication_display %></td>
                  <td><%= m.dosage_instruction %></td>
                  <% med_status = m.status.presence || "unknown" %>
                  <% med_badge = med_status == "active" ? "active" : (med_status == "unknown" ? "unknown" : "inactive") %>
                  <td><span class="badge <%= med_badge %>"><%= med_status == "unknown" ? "Unknown" : med_status %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="empty">No active medications.</p>
        <% end %>
      </div>
    </div>

    <%# ---- Vitals ---- %>
    <div class="chart-card span">
      <div class="chart-card__head"><h2>Vital Signs</h2><span class="count"><%= @vitals.length %></span></div>
      <div class="chart-card__body">
        <% if @vitals.any? %>
          <div class="vitals">
            <% @vitals.each do |v| %>
              <% label = vital_labels.dig(v[:type], :display) || v[:type] %>
              <div class="vital">
                <div class="lbl"><%= label %></div>
                <div class="val"><%= v[:value] %><span class="u"><%= v[:units] %></span></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="empty">No vitals recorded.</p>
        <% end %>
      </div>
    </div>

    <%# ---- Behavioral health screenings (#474) — trended scores ---- %>
    <div class="chart-card span">
      <div class="chart-card__head"><h2>Behavioral Health Screenings</h2><span class="count"><%= @screenings.length %></span></div>
      <div class="chart-card__body">
        <% if @screenings.any? %>
          <table>
            <thead><tr><th>Date</th><th>Instrument</th><th>Score</th><th>Severity</th></tr></thead>
            <tbody>
              <% @screenings.each do |s| %>
                <tr>
                  <td class="mono"><%= s.effective_at.strftime("%b %-d, %Y") %></td>
                  <td><%= s.instrument.short_title %></td>
                  <td class="mono"><%= s.total_score %> / <%= s.instrument.max_score %></td>
                  <td><span class="badge <%= "sev-#{s.severity_slug}" %>"><%= s.severity_band %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="empty">No screenings recorded.</p>
        <% end %>
      </div>
    </div>

    <%# ---- Allergies (detail). The count and the body read AllergyListStatus,
          so a name that passed egress stays in the table when the list is
          incomplete. ---- %>
    <div class="chart-card">
      <div class="chart-card__head"><h2>Allergies</h2><span class="count"><%= @allergy_list_status.count_label %></span></div>
      <div class="chart-card__body">
        <% unless @allergy_list_status.loaded? %>
          <p class="empty"><%= @allergy_list_status.text %></p>
        <% end %>
        <% if @allergy_list_status.loaded? || @allergies.any? %>
          <table>
            <thead><tr><th>Allergen</th><th>Reaction</th><th>Severity</th></tr></thead>
            <tbody>
              <% @allergies.each do |a| %>
                <tr>
                  <td><%= a.display_allergen %></td>
                  <td><%= a.reaction %></td>
                  <td><span class="badge <%= a.severity.present? ? "sev-#{a.severity.to_s.downcase}" : "inactive" %>"><%= a.severity.presence || "—" %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </div>

    <%# ---- Immunizations (IHS-only, #647) ---- %>
    <% if feature_available?(:ihs_immunization) %>
      <div class="chart-card">
        <div class="chart-card__head"><h2>Immunizations</h2><% unless @immunizations_load_failed %><span class="count"><%= @immunizations.length %></span><% end %></div>
        <div class="chart-card__body">
          <% if @immunizations_load_failed %>
            <p class="empty">Immunizations could not be loaded.</p>
          <% elsif @immunizations.any? %>
            <table>
              <thead><tr><th>Vaccine</th><th>Date</th><th>Status</th></tr></thead>
              <tbody>
                <% @immunizations.each do |i| %>
                  <tr>
                    <td><%= i.vaccine_display %></td>
                    <td class="mono"><%= i.occurrence_datetime&.strftime("%b %-d, %Y") %></td>
                    <td><span class="badge <%= %w[completed active].include?(i.status) ? "active" : "inactive" %>"><%= i.status %></span></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="empty">No immunizations on file.</p>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ---- Encounters / Appointments ---- %>
    <div class="chart-card span">
      <div class="chart-card__head"><h2>Encounters &amp; Appointments</h2><span class="count"><%= @encounters.length %></span><% if @progress_note_link %><a href="<%= new_patient_progress_note_path(@patient.dfn) %>" style="margin-left:auto;background:#047857;color:#fff;font-weight:700;font-size:13px;line-height:1;text-decoration:none;border-radius:8px;padding:8px 13px">Write note</a><% end %><% if @demo_visit_link %><a href="<%= new_patient_visit_path(@patient.dfn) %>" style="margin-left:<%= @progress_note_link ? "8px" : "auto" %>;background:#047857;color:#fff;font-weight:700;font-size:13px;line-height:1;text-decoration:none;border-radius:8px;padding:8px 13px">+ New visit</a><% end %></div>
      <div class="chart-card__body">
        <% if @encounters.any? %>
          <table>
            <thead><tr><th>Date</th><th>Location</th><th>Class</th><th>Status</th></tr></thead>
            <tbody>
              <% @encounters.each do |e| %>
                <tr>
                  <td class="mono"><%= e[:datetime].respond_to?(:strftime) ? e[:datetime].strftime("%b %-d, %Y") : e[:datetime] %></td>
                  <td><%= e[:location].presence || "—" %></td>
                  <td>Ambulatory</td>
                  <td><span class="badge inactive"><%= e[:status].to_s.titleize %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="empty">No encounters or upcoming appointments.</p>
        <% end %>
      </div>
    </div>
  </div>


</div>
