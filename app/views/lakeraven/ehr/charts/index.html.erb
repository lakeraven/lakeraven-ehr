<%#
  The way in to a patient chart.

  Self-contained styling, like charts/show: this surface is demonstrated and
  screenshotted on machines that have no asset pipeline warmed up, and a page
  that renders unstyled reads as a broken product rather than a plain one.

  Everything shown here is already scoped by the controller. The template does
  no filtering of its own, so there is one place where visibility is decided.
%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Patients — Lakeraven EHR</title>
    <style>
      *{box-sizing:border-box}
      body{margin:0;background:#f4f6f8;color:#16202a;
           font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
      .wrap{max-width:900px;margin:0 auto;padding:24px 16px 48px}
      .banner{background:#1f3b57;color:#fff;padding:18px 20px;border-radius:10px;margin-bottom:20px}
      .banner h1{margin:0;font-size:23px;font-weight:700;letter-spacing:.2px}
      .banner p{margin:6px 0 0;font-size:13px;opacity:.85}
      form.search{display:flex;gap:8px;margin-bottom:18px}
      form.search input{flex:1;padding:10px 12px;border:1px solid #cfd8e3;border-radius:8px;font-size:15px}
      form.search button{padding:10px 18px;border:0;border-radius:8px;background:#1f3b57;color:#fff;
                         font-size:14px;font-weight:600;cursor:pointer}
      .card{background:#fff;border-radius:10px;box-shadow:0 1px 3px rgba(16,32,48,.12);overflow:hidden}
      .card__head{display:flex;align-items:center;justify-content:space-between;
                  padding:12px 16px;border-bottom:1px solid #e6ecf2}
      .card__head h2{margin:0;font-size:14.5px;font-weight:700;letter-spacing:.2px}
      .count{font-size:12px;color:#5b6b7c}
      table{width:100%;border-collapse:collapse}
      th,td{padding:11px 16px;text-align:left;font-size:14px}
      th{font-size:12px;text-transform:uppercase;letter-spacing:.4px;color:#5b6b7c;background:#fafbfc}
      tbody tr{border-top:1px solid #eef2f6}
      tbody tr:hover{background:#f7fafc}
      td a{color:#1f3b57;font-weight:600;text-decoration:none}
      td a:hover{text-decoration:underline}
      .dfn{font-variant-numeric:tabular-nums;color:#5b6b7c}
      .empty{padding:28px 16px;text-align:center;color:#5b6b7c;font-size:14px}
      .pager{padding:12px 16px;border-top:1px solid #e6ecf2}
      .pager a{color:#1f3b57;font-weight:600;text-decoration:none}
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="banner">
        <h1>Patients</h1>
        <p>Select a patient to open their chart.</p>
      </div>

      <form class="search" method="get" action="<%= patient_charts_path %>">
        <input type="search" name="name" value="<%= @cursor_label %>"
               placeholder="Search by name" aria-label="Search patients by name"
               autocomplete="off">
        <button type="submit">Search</button>
      </form>

      <div class="card">
        <div class="card__head">
          <h2><%= @cursor_label.present? ? "Starting at #{@cursor_label}" : "All patients" %></h2>
          <span class="count"><%= @patients.length %></span>
        </div>

        <% if @patients.any? %>
          <table>
            <thead>
              <tr><th>Name</th><th>DFN</th></tr>
            </thead>
            <tbody>
              <% @patients.each do |patient| %>
                <tr>
                  <%# Built from the engine's route helper, so the link is canonical
                      whatever variant of the list URL was requested. %>
                  <td><a href="<%= patient_chart_path(patient.dfn) %>"><%= patient.display_name %></a></td>
                  <td class="dfn"><%= patient.dfn %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <% if @next_cursor.present? %>
            <p class="pager"><a href="<%= patient_charts_path %>?<%= { name: @next_cursor }.to_query %>">Next</a></p>
          <% end %>
        <% else %>
          <p class="empty">
            <% if @cursor_label.present? %>
              No patients match “<%= @cursor_label %>”.
            <% else %>
              No patients are visible to this session.
            <% end %>
          </p>
        <% end %>
      </div>
    </div>
  </body>
</html>
