<% page_title "Book", @resource[:name] %>

<%= page_header "Book an appointment",
      "#{@resource[:name]}, #{@booking.start_time&.strftime("%b %-d, %Y at %H:%M")}" %>

<%= flash_alert %>

<% if @quick_registered_hrn.present? %>
  <%= alert_box :notice,
        "Registered#{" #{@chosen[:name]}" if @chosen}.",
        "Chart number #{@quick_registered_hrn}.",
        "Book them now; the front desk completes the registration when they arrive.",
        id: "quick-registered" %>
<% end %>

<%= form_errors @booking,
      "The appointment was not booked.",
      id: "booking-errors" %>

<%= form_with url: scheduling_new_clinic_appointment_path(@resource[:id]),
      method: :get,
      local: true,
      id: "patient-search",
      class: "flex items-end gap-2" do %>
  <%= hidden_field_tag :start, @booking.start %>
  <%= form_field :q, "Patient name starts with" do |aria| %>
    <%= text_field_tag :q,
          params[:q],
          id: "q",
          autocomplete: "off",
          aria: aria %>
  <% end %>
  <%= submit_tag "Find patient",
        name: nil,
        class: "button-secondary" %>
<% end %>

<% if params[:q].present? && @patients.empty? && capability?("patient.quick_register") %>
  <p
    id="no-patient-found"
    class="mt-2"
  >
    No patient's name starts with that.
    <%= link_to "Register a caller who has no chart",
          scheduling_new_clinic_registration_path(@resource[:id], start: @booking.start, length: @booking.length),
          id: "quick-register-link" %>
  </p>
<% end %>

<%= form_with scope: :booking,
      url: scheduling_clinic_appointments_path(@resource[:id]),
      method: :post,
      local: true,
      id: "booking-form",
      class: "card mt-4 flex flex-col gap-4" do |f| %>
  <%= f.hidden_field :start, value: @booking.start %>
  <%= hidden_field_tag :q, params[:q] %>

  <%= choice_list f,
        :patient_dfn,
        legend: "Patient",
        choices: @patients.map { |patient|
          [ patient[:dfn],
            "#{patient[:name]}, #{patient[:hrn] ? "HRN #{patient[:hrn]}" : "no health record number"}, born #{patient[:dob]&.strftime("%b %-d, %Y")}",
            { patient: patient[:dfn] } ]
        },
        selected: @booking.patient_dfn do %>
    <%= render "lakeraven/ehr/shared/lookup_chosen",
          form: f,
          attribute: :patient_dfn,
          selected: @booking.patient_dfn,
          any_choices: @patients.any?,
          chosen_text: @chosen ? "Patient chosen: #{@chosen[:name]}, chart number #{@chosen[:mrn].presence || "none"}." : "Patient chosen.",
          empty_text: "Find the patient by name above." %>
  <% end %>

  <%= form_field :length, "Length (minutes)", form: f do |aria| %>
    <%= f.number_field :length,
          value: @booking.length,
          min: @resource[:time_scale],
          step: @resource[:time_scale],
          required: true,
          aria: aria %>
  <% end %>

  <%= form_field :note, "Note (optional)", form: f do |aria| %>
    <%= f.text_field :note,
          value: @booking.note,
          maxlength: 150,
          aria: aria %>
  <% end %>

  <%= f.submit "Book",
        class: "button-primary self-start" %>
<% end %>
