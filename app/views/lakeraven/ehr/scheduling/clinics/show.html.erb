<% page_title "#{@resource[:name]} | Scheduling" %>

<%= page_header @resource[:name],
      @date.strftime("%A, %b %-d, %Y") %>

<% if @notice.present? %>
  <%= alert_box :notice, @notice, id: "notice" %>
<% end %>

<%= flash_alert id: "clinic-alert" %>

<% if @booked_id.present? %>
  <%= alert_box :notice, "Booked.", id: "booked" %>
<% end %>

<%= form_with url: scheduling_clinic_path(@resource[:id]),
      method: :get,
      local: true,
      class: "flex items-end gap-2" do %>
  <%= form_field :date, "Day" do |aria| %>
    <%= date_field_tag :date,
          @date,
          id: "date",
          aria: aria %>
  <% end %>
  <%= submit_tag "Show",
        name: nil,
        class: "button-secondary" %>
<% end %>

<p>
  <%= link_to "See the week",
        scheduling_clinic_week_path(@resource[:id], date: @date.iso8601),
        id: "week-view" %>
</p>

<p>
  <%= link_to "Find an open time",
        scheduling_clinic_open_times_path(@resource[:id], from: @date.iso8601),
        id: "find-open-time" %>
</p>

<% if can_set_hours?(@resource) %>
  <p>
    <%= link_to "Set the clinic's hours",
          scheduling_new_clinic_hours_path(@resource[:id]),
          id: "set-hours" %>
  </p>
<% end %>

<h2>Booked</h2>
<% if @appointments.empty? %>
  <%= empty_state "No appointments." %>
<% else %>
  <table
    id="appointments"
    class="data-table"
  >
    <caption class="sr-only">Appointments on <%= @resource[:name] %></caption>
    <thead>
      <tr>
        <th scope="col">Time</th>
        <th scope="col">Patient</th>
        <th scope="col">Status</th>
        <th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @appointments.sort_by { |a| a[:start_time] }.each do |appointment| %>
        <% status_key, status = appointment_status(appointment) %>
        <tr
          id="appointment-<%= appointment[:id] %>"
          data-patient="<%= appointment[:patient_dfn] %>"
          data-appointment="<%= appointment[:id] %>"
        >
          <td><%= appointment[:start_time].strftime("%H:%M") %>–<%= appointment[:end_time].strftime("%H:%M") %></td>
          <td>
            <%= link_to appointment[:patient_name],
                  scheduling_patient_appointments_path(appointment[:patient_dfn]),
                  data: { patient_appointments: true } %>
          </td>
          <td data-status="<%= status_key %>"><%= status_badge status_key, status %></td>
          <td>
            <% if status_key == "booked" && can_book?(@resource) %>
              <% if appointment[:start_time].to_date == Date.today %>
                <%= link_to "Check in",
                      scheduling_checkin_clinic_appointment_path(@resource[:id], appointment[:id], date: @date.iso8601) %>
              <% end %>
              <%= link_to "Cancel",
                    scheduling_cancel_clinic_appointment_path(@resource[:id], appointment[:id], date: @date.iso8601) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2>Open times</h2>
<% times = @day.times %>
<% if times.empty? %>
  <%= empty_state "The clinic has no open times this day.",
        id: "no-open-times" %>
<% else %>
  <table
    id="open-times"
    class="data-table"
  >
    <caption class="sr-only">Open times on <%= @resource[:name] %></caption>
    <thead>
      <tr>
        <th scope="col">Time</th>
        <th scope="col">Places left</th>
        <th scope="col"><span class="sr-only">Book</span></th>
      </tr>
    </thead>
    <tbody>
      <% times.each do |time| %>
        <tr data-time="<%= time.at.strftime("%H:%M") %>">
          <td><%= time.at.strftime("%H:%M") %></td>
          <td data-open="<%= time.open %>"><%= time.open.zero? ? "Full" : time.open %></td>
          <td>
            <% if time.open.positive? && can_book?(@resource) %>
              <%= link_to "Book",
                    scheduling_new_clinic_appointment_path(@resource[:id], start: time.at.strftime("%Y-%m-%dT%H:%M")) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
