<% page_title "#{@resource[:name]} | Scheduling" %>

<%= page_header @resource[:name],
      @date.strftime("%A, %b %-d, %Y") %>

<% if @notice.present? %>
  <%= alert_box :notice, @notice, id: "notice" %>
<% end %>

<%= flash_alert id: "clinic-alert" %>

<% if @booked_id.present? %>
  <%= alert_box :notice, "Booked.", id: "booked" %>
<% end %>

<%= form_with url: scheduling_clinic_path(@resource[:id]),
      method: :get,
      local: true,
      class: "flex items-end gap-2" do %>
  <%= form_field :date, "Day" do |aria| %>
    <%= date_field_tag :date,
          @date,
          id: "date",
          aria: aria %>
  <% end %>
  <%= submit_tag "Show",
        name: nil,
        class: "button-secondary" %>
<% end %>

<p>
  <%= link_to "See the week",
        scheduling_clinic_week_path(@resource[:id], date: @date.iso8601),
        id: "week-view" %>
</p>

<p>
  <%= link_to "Clinic settings",
        scheduling_clinic_settings_path(@resource[:id]),
        id: "clinic-settings-link" %>
</p>

<p>
  <%= link_to "Find an open time",
        scheduling_clinic_open_times_path(@resource[:id], from: @date.iso8601),
        id: "find-open-time" %>
</p>

<p>
  <%= link_to "See the wait list",
        scheduling_clinic_wait_list_path(@resource[:id]),
        id: "wait-list-link" %>
</p>

<%= render "walk_in_link", resource: @resource, date: @date %>

<% if can_set_hours?(@resource) %>
  <p>
    <%= link_to "Set the clinic's hours",
          scheduling_new_clinic_hours_path(@resource[:id]),
          id: "set-hours" %>
  </p>
<% end %>

<h2>Booked</h2>
<% if @appointments.empty? %>
  <%= empty_state "No appointments." %>
<% else %>
  <table
    id="appointments"
    class="data-table"
  >
    <caption class="sr-only">Appointments on <%= @resource[:name] %></caption>
    <thead>
      <tr>
        <th scope="col">Time</th>
        <th scope="col">Patient</th>
        <th scope="col">Status</th>
        <th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @appointments.sort_by { |a| a[:start_time] }.each do |appointment| %>
        <% status_key, status = appointment_status(appointment) %>
        <tr
          id="appointment-<%= appointment[:id] %>"
          data-patient="<%= appointment[:patient_dfn] %>"
          data-appointment="<%= appointment[:id] %>"
        >
          <td><%= appointment[:start_time].strftime("%H:%M") %>–<%= appointment[:end_time].strftime("%H:%M") %></td>
          <td>
            <%= link_to appointment[:patient_name],
                  scheduling_patient_appointments_path(appointment[:patient_dfn]),
                  data: { patient_appointments: true } %>
          </td>
          <td data-status="<%= status_key %>">
            <%= status_badge status_key, status %>
            <% if appointment[:overbook] %>
              <span data-overbook="true"><%= status_badge "warning", "Overbook" %></span>
            <% end %>
          </td>
          <td>
            <%= render "lakeraven/ehr/scheduling/appointments/actions",
                  appointment: appointment,
                  resource: @resource,
                  date: @date %>
            <%= render "closed_actions", resource: @resource, appointment: appointment, date: @date, status_key: status_key %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2>Hours</h2>
<% if @day.closed %>
  <%= alert_box :notice,
        "#{closed_reason(@day.closed)}: the clinic takes no appointments this day.",
        id: "day-closed" %>
<% elsif @day.listed_blocks.empty? %>
  <%= empty_state "The clinic has no hours this day.",
        id: "no-hours" %>
<% else %>
  <table
    id="blocks"
    class="data-table"
  >
    <caption class="sr-only">Hours on <%= @resource[:name] %></caption>
    <thead>
      <tr>
        <th scope="col">From</th>
        <th scope="col">To</th>
        <th scope="col">Access type</th>
        <th scope="col">Slots</th>
      </tr>
    </thead>
    <tbody>
      <% @day.listed_blocks.sort_by { |b| b[:start_time] }.each do |block| %>
        <tr data-block="<%= block[:start_time].strftime("%H:%M") %>">
          <td><%= block[:start_time].strftime("%H:%M") %></td>
          <td><%= block[:end_time].strftime("%H:%M") %></td>
          <td data-access-type="<%= block[:access_type_id] %>"><%= @access_type_names[block[:access_type_id]] || "Not named" %></td>
          <td data-slots="<%= block[:slots] %>"><%= block[:slots] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2>Open times</h2>
<% times = @day.times %>
<% if times.empty? %>
  <%= empty_state "The clinic has no open times this day.",
        id: "no-open-times" %>
<% else %>
  <table
    id="open-times"
    class="data-table"
  >
    <caption class="sr-only">Open times on <%= @resource[:name] %></caption>
    <thead>
      <tr>
        <th scope="col">Time</th>
        <th scope="col">Places left</th>
        <th scope="col"><span class="sr-only">Book</span></th>
      </tr>
    </thead>
    <tbody>
      <% times.each do |time| %>
        <tr data-time="<%= time.at.strftime("%H:%M") %>">
          <td><%= time.at.strftime("%H:%M") %></td>
          <td data-open="<%= time.open %>"><%= time.open.zero? ? "Full" : time.open %></td>
          <td>
            <% if time.open.positive? && can_book?(@resource) %>
              <%= link_to "Book",
                    scheduling_new_clinic_appointment_path(@resource[:id], start: time.at.strftime("%Y-%m-%dT%H:%M")) %>
            <% elsif can_overbook?(@resource) %>
              <%= link_to "Overbook",
                    scheduling_new_clinic_appointment_path(@resource[:id], start: time.at.strftime("%Y-%m-%dT%H:%M")),
                    data: { overbook: true } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
