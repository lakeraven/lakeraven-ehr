<%# The day view's actions that change a booked appointment's booking (rpms-ux S-SCH-02.8, S-SCH-09). Check-in, check-out and no-show are in the row beside them. %>
<%= link_to "Move",
      scheduling_reschedule_clinic_appointment_path(resource[:id], appointment[:id], date: date.iso8601),
      data: { action_name: "move" },
      aria: { label: "Move #{appointment[:patient_name]}'s appointment at #{appointment[:start_time].strftime('%H:%M')}" } %>
<%= link_to "Change details",
      scheduling_appointment_details_path(resource[:id], appointment[:id], date: date.iso8601),
      data: { action_name: "details" },
      aria: { label: "Change the details of #{appointment[:patient_name]}'s appointment at #{appointment[:start_time].strftime('%H:%M')}" } %>
