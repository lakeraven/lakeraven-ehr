<% page_title "Scheduling" %>

<%= page_header "Scheduling",
      "Choose a clinic to see its day and book into it." do %>
  <%= link_to "Appointments",
        scheduling_appointment_list_path,
        id: "appointment-list-link" %>
  <%= link_to "Appointments needing action",
        scheduling_needing_action_path,
        id: "needing-action-link" %>
  <%= link_to "Resource groups",
        scheduling_resource_groups_path,
        id: "resource-groups-link" %>
  <% if capability?("scheduling.supervise") %>
    <%= link_to "Access types",
          scheduling_access_types_path,
          id: "access-types-link" %>
  <% end %>
<% end %>

<% if @resources.empty? %>
  <%= empty_state "No clinic resources are open to you.",
        "Your site manager can give you access to a clinic.",
        id: "no-resources" %>
<% else %>
  <ul
    id="resources"
    class="card flex flex-col gap-2"
  >
    <% @resources.each do |resource| %>
      <li data-resource="<%= resource[:id] %>">
        <%= link_to resource[:name], scheduling_clinic_week_path(resource[:id]) %>
        <% if resource[:inactive] %>
          <span class="hint">(inactive)</span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
