<% page_title "Change details", @resource[:name] %>

<%= page_header "Change an appointment's details",
      "#{@appointment[:patient_name]}, #{@resource[:name]}, #{@appointment[:start_time].strftime("%b %-d, %Y at %H:%M")}" %>

<%= flash_alert id: "details-alert" %>

<%= form_errors @details,
      "Nothing was changed.",
      id: "details-errors" %>

<%= form_with scope: :details,
      url: scheduling_appointment_details_path(@resource[:id], @appointment[:id]),
      method: :post,
      local: true,
      id: "details-form",
      class: "card flex flex-col gap-4" do |f| %>
  <%= hidden_field_tag :date, @date.iso8601 %>

  <% if @details.kind == :closed %>
    <%# CANCELLATION REMARKS, PATIENT (#2.98) field 17. %>
    <%= form_field :remarks,
          "Remarks",
          form: f,
          hint: "Why it was cancelled or missed, 3 to 160 characters." do |aria| %>
      <%= f.text_field :remarks,
            value: @details.remarks,
            maxlength: 160,
            required: true,
            aria: aria %>
    <% end %>
  <% else %>
    <%# The note: BSDX APPOINTMENT (#9002018.4) field 1 and OTHER, PATIENT (#44.003) field 3. %>
    <%= form_field :note,
          "Note (optional)",
          form: f,
          hint: "2 to 150 characters, without a semicolon or a colon." do |aria| %>
      <%= f.text_field :note,
            value: @details.note,
            maxlength: 150,
            aria: aria %>
    <% end %>

    <% if @variable %>
      <%# LENGTH OF APP'T, PATIENT (#44.003) field 1. The start time stays. %>
      <%= form_field :length,
            "Length (minutes)",
            form: f,
            hint: "The appointment still starts at #{@appointment[:start_time].strftime("%H:%M")}." do |aria| %>
        <%= f.number_field :length,
              value: @details.length,
              min: @resource[:time_scale],
              step: @resource[:time_scale],
              required: true,
              aria: aria %>
      <% end %>
    <% end %>
  <% end %>

  <%= f.submit "Save",
        class: "button-primary self-start" %>
<% end %>

<p class="mt-6">
  <%= link_to "Back to the clinic's day", scheduling_clinic_path(@resource[:id], date: @date.iso8601) %>
</p>
