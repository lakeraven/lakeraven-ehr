<% content_for :title, "Check in | #{@resource[:name]} | Lakeraven EHR" %>

<div class="page-header">
  <h1>Check in</h1>
  <p>
    <%= @appointment[:patient_name] %>, <%= @resource[:name] %>, <%= @appointment[:start_time].strftime("%b %-d, %Y at %H:%M") %>
  </p>
</div>

<% if flash[:alert].present? %>
  <div
    class="alert alert--error"
    role="alert"
  >
    <p><%= flash[:alert] %></p>
  </div>
<% end %>

<% if @checkin.errors.any? %>
  <div
    id="checkin-errors"
    class="alert alert--error"
    role="alert"
  >
    <p>
      The patient was not checked in.
    </p>
    <ul>
      <% @checkin.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with scope: :checkin,
      url: scheduling_checkin_clinic_appointment_path(@resource[:id], @appointment[:id]),
      method: :post,
      local: true,
      id: "checkin-form",
      class: "card flex flex-col gap-4" do |f| %>
  <%= hidden_field_tag :date, @date.iso8601 %>

  <div class="flex flex-col gap-1">
    <%= f.label :at, "Checked in at" %>
    <%= f.datetime_local_field :at,
          value: @checkin.at,
          required: true,
          class: "rounded border border-slate-300 px-3 py-2" %>
  </div>

  <fieldset class="flex flex-col gap-2">
    <legend>
      Visit provider<%= " (required at this clinic)" if @checkin.provider_required %>
    </legend>
    <div class="flex items-end gap-2">
      <%= label_tag :provider_search, "Provider name starts with", class: "sr-only" %>
      <%= text_field_tag :provider_search,
            params[:provider_search],
            placeholder: "Provider name starts with",
            class: "rounded border border-slate-300 px-3 py-2" %>
      <%= submit_tag "Find provider",
            name: nil,
            formaction: scheduling_checkin_clinic_appointment_path(@resource[:id], @appointment[:id]),
            formmethod: :get,
            formnovalidate: true,
            class: "min-h-9 bg-white px-3 py-2 ring-1 ring-slate-300 ring-inset" %>
    </div>
    <% @providers.each do |provider| %>
      <label data-provider="<%= provider.ien %>">
        <%= f.radio_button :provider_ien,
              provider.ien,
              checked: @checkin.provider_ien == provider.ien %>
        <%= provider.name %>
      </label>
    <% end %>
    <% if @providers.empty? && @checkin.provider_ien %>
      <%= f.hidden_field :provider_ien, value: @checkin.provider_ien %>
      <p class="hint">Provider chosen.</p>
    <% end %>
  </fieldset>

  <%= f.submit "Check in",
        class: "min-h-9 self-start bg-slate-900 px-4 py-2 text-white hover:bg-slate-700" %>
<% end %>

<p class="mt-6">
  <%= link_to "Back to the clinic's day", scheduling_clinic_path(@resource[:id], date: @date.iso8601) %>
</p>
