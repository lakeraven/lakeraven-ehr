<% page_title "Check in", @resource[:name] %>

<%= page_header "Check in",
      "#{@appointment[:patient_name]}, #{@resource[:name]}, #{@appointment[:start_time].strftime("%b %-d, %Y at %H:%M")}" %>

<%= flash_alert %>

<%# S-REG-03.2: coverage in force today, as AG answers (MCDACT/MCRACT/PVTACT^AGGARVAL). %>
<% case @coverage %>
<% when :lapsed %>
  <%= alert_box :error,
        "None of this patient's coverage is in force today.",
        "Ask for a current Medicaid, Medicare or insurance card before the visit, so it can be billed.",
        id: "coverage-lapsed" do %>
    <% if capability?("registration.view") %>
      <p>
        <%= link_to "See the patient's coverage", registration_patient_coverage_path(@appointment[:patient_dfn]) %>
      </p>
    <% end %>
  <% end %>
<% when :none %>
  <%= alert_box :notice,
        "No Medicaid, Medicare or private insurance is on file for this patient.",
        id: "coverage-none" %>
<% when :unchecked %>
  <%= alert_box :notice,
        "Coverage was not checked: RPMS did not answer, or does not let you read it.",
        "Coverage is read through Patient Registration.",
        id: "coverage-unchecked" %>
<% end %>

<%= form_errors @checkin,
      "The patient was not checked in.",
      id: "checkin-errors" %>

<%= form_with scope: :checkin,
      url: scheduling_checkin_clinic_appointment_path(@resource[:id], @appointment[:id]),
      method: :post,
      local: true,
      id: "checkin-form",
      class: "card flex flex-col gap-4" do |f| %>
  <%= hidden_field_tag :date, @date.iso8601 %>

  <%= form_field :at, "Checked in at", form: f do |aria| %>
    <%= f.datetime_local_field :at,
          value: @checkin.at,
          required: true,
          aria: aria %>
  <% end %>

  <%= lookup_field f,
        :provider_ien,
        legend: "Visit provider#{" (required at this clinic)" if @checkin.provider_required}",
        search: :provider_search,
        search_label: "Provider name starts with",
        find_label: "Find provider",
        find_url: scheduling_checkin_clinic_appointment_path(@resource[:id], @appointment[:id]),
        find_method: :get,
        choices: @providers.map { |provider| [ provider.ien, provider.name, { provider: provider.ien } ] },
        selected: @checkin.provider_ien,
        chosen_text: "Provider chosen." %>

  <%= f.submit "Check in",
        class: "button-primary self-start" %>
<% end %>

<p class="mt-6">
  <%= link_to "Back to the clinic's day", scheduling_clinic_path(@resource[:id], date: @date.iso8601) %>
</p>
