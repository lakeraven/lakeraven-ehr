<% page_title "Cancel", @resource[:name] %>

<%= page_header "Cancel an appointment",
      "#{@appointment[:patient_name]}, #{@resource[:name]}, #{@appointment[:start_time].strftime("%b %-d, %Y at %H:%M")}" %>

<%= flash_alert %>

<%= form_errors @cancellation,
      "The appointment was not cancelled.",
      id: "cancellation-errors" %>

<%= form_with scope: :cancellation,
      url: scheduling_cancel_clinic_appointment_path(@resource[:id], @appointment[:id]),
      method: :post,
      local: true,
      id: "cancellation-form",
      class: "card flex flex-col gap-4" do |f| %>
  <%= hidden_field_tag :date, @date.iso8601 %>

  <%= choice_list f,
        :whom,
        legend: "Who cancelled",
        choices: Lakeraven::EHR::AppointmentCancellation::WHOM.map { |code, label| [ code, label.capitalize ] },
        selected: @cancellation.whom,
        inline: true do %>
    <%= submit_tag "Show reasons",
          name: nil,
          formaction: scheduling_cancel_clinic_appointment_path(@resource[:id], @appointment[:id]),
          formmethod: :get,
          formnovalidate: true,
          class: "button-secondary" %>
  <% end %>

  <%= form_field :reason_ien, "Reason", form: f do |aria| %>
    <%= f.select :reason_ien,
          options_for_select(@reasons.map { |r| [ r[:name], r[:ien] ] }, @cancellation.reason_ien),
          { include_blank: "Choose a reason" },
          aria: aria %>
  <% end %>

  <%= form_field :remarks, "Remarks (optional, 3 to 160 characters)", form: f do |aria| %>
    <%= f.text_field :remarks,
          value: @cancellation.remarks,
          maxlength: 160,
          aria: aria %>
  <% end %>

  <%= f.submit "Cancel the appointment",
        class: "button-primary self-start" %>
<% end %>

<p class="mt-6">
  <%= link_to "Back to the clinic's day", scheduling_clinic_path(@resource[:id], date: @date.iso8601) %>
</p>
