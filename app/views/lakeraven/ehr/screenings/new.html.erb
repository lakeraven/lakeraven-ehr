<%#
  Server-rendered screening form. NO JavaScript: validation, the missing-item
  callout and the item-9 safety prompt are all produced by re-rendering this
  template from ScreeningsController#create, so the form behaves identically
  with scripting disabled.

  Accessibility: one <fieldset>/<legend> per question groups its four radios,
  every input has an explicit <label for>, error and safety regions are
  role="alert" with in-page links to the offending question, and DOM order is
  question order so keyboard tabbing walks the instrument top to bottom.
%>
<% page_title "#{@instrument.short_title}" %>
<%
  missing = @result&.missing_link_ids || []
  safety_prompt = @result&.safety_prompt_required?
  answered = (@answers || {}).transform_values(&:to_s)
%>

<div class="page-header">
  <h1><%= @instrument.title %></h1>
  <p>Patient #<%= @dfn %> &middot; <%= @instrument.items.length %> items,
     scored 0&ndash;<%= @instrument.max_score %></p>
</div>

<%= form_with url: patient_screenings_path(@dfn), method: :post, class: "screening-form" do %>
  <input type="hidden" name="instrument" value="<%= @instrument.key %>">
  <%# Identifies THIS submission. A double-tap or a back-button replay carries
      the same token and records one administration; a screening administered
      again later comes from a newly rendered form and is its own. %>
  <input type="hidden" name="submission_token" value="<%= @submission_token %>">

  <% if safety_prompt %>
    <%# Clinical-safety gate. The submission is NOT stored until this is
        acknowledged; the service enforces it, this only presents it. %>
    <div class="screening-safety" role="alert" aria-labelledby="safety-heading">
      <h2 id="safety-heading">Safety check required before this screening can be saved</h2>
      <p><%= @instrument.safety_guidance %></p>
      <p><a href="#item-<%= @instrument.safety_link_id %>">Review item
        <%= @instrument.safety_item.position %></a></p>
      <div class="screening-safety__ack">
        <input type="checkbox" id="safety_acknowledged" name="safety_acknowledged" value="1" autofocus>
        <label for="safety_acknowledged">
          I have reviewed the self-harm response with the patient and taken the
          appropriate safety steps.
        </label>
      </div>
    </div>
  <% end %>

  <% if missing.any? %>
    <div class="screening-errors" role="alert" aria-labelledby="missing-heading">
      <h2 id="missing-heading">This screening was not scored</h2>
      <p>Answer every item, then submit again. No score has been recorded.</p>
      <ul>
        <% missing.each do |link_id| %>
          <% item = @instrument.item_for(link_id) %>
          <li><a href="#item-<%= link_id %>">Item <%= item.position %>: <%= item.text %></a></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @result&.errors&.include?(:already_submitted) %>
    <div class="screening-errors" role="alert">
      <h2>This form has already been submitted</h2>
      <p>
        A screening was recorded from this form, and the answers have since
        changed, so this is not a repeat of that submission. Nothing has been
        recorded. To correct the recorded screening, or to record a new one,
        start a fresh screening from the patient&rsquo;s history.
      </p>
      <p><a href="<%= patient_screenings_path(@dfn) %>">Previous screenings</a></p>
    </div>
  <% end %>

  <%# Fail closed AND SAY WHY: without these, a refusal re-rendered the form
      with the answers still selected and no statement that anything had been
      refused — which reads as "the page reloaded". %>
  <% if @result&.errors&.include?(:conflicting_record) %>
    <div class="screening-errors" role="alert">
      <h2>This screening could not be recorded</h2>
      <p>
        An existing record for this submission does not agree with itself, so
        it cannot be treated as a previous recording of this screening, and it
        has not been altered. Nothing has been recorded. Report this to support
        with the patient number and today&rsquo;s date.
      </p>
    </div>
  <% end %>

  <% if @result&.errors&.include?(:persistence_error) %>
    <div class="screening-errors" role="alert">
      <h2>This screening could not be recorded</h2>
      <p>
        The record could not be saved. Nothing has been recorded. Your answers
        are still on this form — submit again, and if it fails a second time,
        record the screening on paper and report the failure.
      </p>
    </div>
  <% end %>

  <% if @result&.errors&.include?(:missing_administered_by) %>
    <div class="screening-errors" role="alert">
      <h2>Clinician sign-on required</h2>
      <p>A self-harm response must be acknowledged by a named clinician. Nothing has been recorded.</p>
    </div>
  <% end %>

  <%# Every reason the submission was refused is shown, not just the first:
      the visit AND the unanswered items, in one pass. %>
  <% if @result&.errors&.include?(:missing_encounter) && !@visits_unreadable && @open_visits.any? %>
    <div class="screening-errors" role="alert">
      <h2>Visit required</h2>
      <p>A screening is recorded against the patient&rsquo;s open visit. Choose the visit below and submit again.</p>
    </div>
  <% end %>

  <% if @result&.errors&.include?(:invalid_encounter) && !@visits_unreadable %>
    <div class="screening-errors" role="alert">
      <h2>Choose an open visit</h2>
      <p>The visit that was submitted is not one of this patient&rsquo;s open visits. Nothing has been recorded.<%= " Choose one of the visits below." if @open_visits.present? %></p>
    </div>
  <% end %>

  <% if @visits_unreadable %>
    <div class="screening-errors" role="alert">
      <h2>Visits could not be read</h2>
      <p>This patient&rsquo;s visits could not be read, so a visit cannot be chosen and no screening can be recorded now. Try again, and report it to support if it keeps happening.</p>
    </div>
  <% elsif @open_visits.empty? %>
    <div class="screening-errors" role="alert">
      <h2>No open visit</h2>
      <p>This patient has no open visit. Check the patient in first, then start the screening again. If the patient is already checked in, reload this page, and report it if the visit still does not appear.</p>
    </div>
  <% end %>

  <% if @open_visits.any? %>
    <fieldset class="screening-visit" id="encounter_ien_group" aria-describedby="encounter_ien_hint">
      <legend>Visit</legend>
      <p id="encounter_ien_hint" class="hint">Choose the open visit this screening is being administered against.</p>
      <% @open_visits.each do |visit| %>
        <% ien = visit[:visit_ien].to_s.strip %>
        <% input_id = "encounter_ien_#{ien}" %>
        <div class="screening-visit__choice">
          <input type="radio" id="<%= input_id %>" name="encounter_ien" value="<%= ien %>"
                 <%= "checked" if @encounter_ien == ien %>>
          <label for="<%= input_id %>">
            <%= visit[:datetime].strftime("%b %-d, %Y %H:%M") %>
            <%# "not shown": the record has one and the egress filter withheld it;
                "not recorded": the record has none. %>
            &middot; <%= visit[:location].presence || (visit[:location_recorded] ? "Clinic not shown" : "Clinic not recorded") %>
            &middot; <%= visit[:provider].presence || (visit[:provider_recorded] ? "Provider not shown" : "Provider not recorded") %>
          </label>
        </div>
      <% end %>
    </fieldset>
  <% end %>

  <p class="screening-preamble"><%= @instrument.preamble %></p>

  <ol class="screening-items">
    <% @instrument.items.each do |item| %>
      <% item_missing = missing.include?(item.link_id) %>
      <li>
        <fieldset id="item-<%= item.link_id %>"
                  class="screening-item<%= " screening-item--missing" if item_missing %>"
                  aria-invalid="<%= item_missing %>"
                  <% if item_missing %>aria-describedby="item-<%= item.link_id %>-error"<% end %>>
          <legend><span class="screening-item__n"><%= item.position %>.</span> <%= item.text %></legend>
          <% if item_missing %>
            <p class="screening-item__error" id="item-<%= item.link_id %>-error">Not answered.</p>
          <% end %>
          <div class="screening-choices">
            <% Lakeraven::EHR::ScreeningInstrument::CHOICES.each do |choice| %>
              <% input_id = "answer-#{item.link_id}-#{choice.value}" %>
              <div class="screening-choice">
                <input type="radio" id="<%= input_id %>"
                       name="answers[<%= item.link_id %>]" value="<%= choice.value %>"
                       <%= "checked" if answered[item.link_id] == choice.value.to_s %>>
                <label for="<%= input_id %>">
                  <%= choice.text %> <span class="screening-choice__score">(<%= choice.value %>)</span>
                </label>
              </div>
            <% end %>
          </div>
        </fieldset>
      </li>
    <% end %>
  </ol>

  <div class="screening-actions">
    <button type="submit">Score and save <%= @instrument.short_title %></button>
    <a href="<%= patient_screenings_path(@dfn) %>">Previous screenings</a>
  </div>
<% end %>
