<% page_title "Record an allergy" %>
<%# The patient is in the banner above (shared/_patient_banner), the same
    one the chart shows, so the page does not name them again.
    Codes are the ones RPMS accepts for a new allergy (rpms-rpc
    RpmsRpc::Api::Allergy: TYPE, NATURE, OBHX, SEVERITY). %>

<%= page_header "Record an allergy",
      [ "Find what the patient reacts to, then say how it was found out.",
        "Dates and times are the site's." ] %>

<% if @allergy_not_saved %>
  <%= alert_box :error, id: "allergy-failure" do %>
    <h2 class="mt-0 text-lg"><%= allergy_failure_heading %></h2>
    <p><%= allergy_failure_detail %></p>
  <% end %>
<% end %>

<%= form_with url: patient_allergies_path(@dfn),
      scope: :allergy,
      method: :post,
      class: "allergy-form entry-form" do |f| %>
  <fieldset>
    <legend>What the patient reacts to</legend>

    <%# GMRAGNT: the agent and its variable pointer, as RPMS's allergen
        search (ORWDAL32 ALLERGY MATCH) gives them. %>
    <%= lookup_field f,
          :agent_choice,
          legend: "Allergen",
          search: :allergen_search,
          search_label: "Allergen name starts with",
          find_label: "Find allergen",
          find_url: new_patient_allergy_path(@dfn),
          find_method: :get,
          choices: @allergen_matches.map { |match| [ allergen_choice(match), allergen_label(match), { allergen: match[:agent_pointer] } ] },
          selected: form_value("agent_choice"),
          chosen_text: chosen_text(form_value("agent_choice"), "Allergen"),
          empty_text: allergen_empty_text,
          hint: "Search allergies, foods, drugs, drug ingredients and drug classes." %>

    <div class="field-row">
      <%# GMRATYPE, PATIENT ALLERGIES (120.8) field 3.1. %>
      <%= form_field :type, "Type", form: f do |aria| %>
        <%= f.select :type,
              [ [ "Drug", "D" ], [ "Food", "F" ], [ "Other", "O" ], [ "Drug and food", "DF" ] ],
              { include_blank: "Choose a type", selected: form_value("type") },
              required: true,
              aria: aria %>
      <% end %>

      <%# GMRANATR, PATIENT ALLERGIES (120.8) field 17. %>
      <%= form_field :nature, "Nature of reaction", form: f do |aria| %>
        <%= f.select :nature,
              [ [ "Allergy", "A" ], [ "Pharmacologic (side effect)", "P" ], [ "Unknown", "U" ] ],
              { include_blank: "Choose a nature", selected: form_value("nature") },
              required: true,
              aria: aria %>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend>How it is known</legend>

    <%# GMRAOBHX: "o" observed here, "h" reported history. %>
    <%= choice_list f,
          :observed_or_historical,
          legend: "Observed or historical",
          choices: [ [ "o", "Observed in this clinic" ], [ "h", "Historical (reported by the patient or another record)" ] ],
          selected: form_value("observed_or_historical") %>

    <div class="field-row">
      <%# GMRAORDT, a FileMan date and time, converted on submit. %>
      <%= form_field :originated_on,
            "Entered on",
            form: f,
            hint: "The site's date and time." do |aria| %>
        <%= f.datetime_local_field :originated_on,
              value: form_value("originated_on"),
              max: site_now_for_picker,
              required: true,
              aria: aria %>
      <% end %>

      <%# GMRARDT, a FileMan date, converted on submit. %>
      <%= form_field :reaction_on,
            "Reaction date (optional)",
            form: f do |aria| %>
        <%= f.date_field :reaction_on,
              value: form_value("reaction_on"),
              max: site_today_for_picker,
              aria: aria %>
      <% end %>
    </div>

    <%# GMRASEVR: 1 mild, 2 moderate, 3 severe. %>
    <%= form_field :severity, "Severity (optional)", form: f do |aria| %>
      <%= f.select :severity,
            [ [ "Mild", "1" ], [ "Moderate", "2" ], [ "Severe", "3" ] ],
            { include_blank: "Not given", selected: form_value("severity") },
            class: "sm:max-w-xs",
            aria: aria %>
    <% end %>
  </fieldset>

  <fieldset>
    <legend>Reaction (optional)</legend>

    <%# GMRASYMP(n) = "ien^text^FileMan date": the symptom from the
        SIGN/SYMPTOMS catalog (ORWDAL32 SYMPTOMS), its date converted on submit. %>
    <%= lookup_field f,
          :symptom_choice,
          legend: "Symptom",
          search: :symptom_search,
          search_label: "Symptom name starts with",
          find_label: "Find symptom",
          find_url: new_patient_allergy_path(@dfn),
          find_method: :get,
          choices: @symptom_matches.map { |match| [ "#{match[:ien]}^#{match[:name]}", match[:label], { symptom: match[:ien] } ] },
          selected: form_value("symptom_choice"),
          chosen_text: chosen_text(form_value("symptom_choice"), "Symptom"),
          empty_text: symptom_empty_text %>

    <%= form_field :symptom_on,
          "Symptom date (optional)",
          form: f do |aria| %>
      <%= f.date_field :symptom_on,
            value: form_value("symptom_on"),
            max: site_today_for_picker,
            class: "sm:max-w-xs",
            aria: aria %>
    <% end %>
  </fieldset>

  <%# GMRACMTS(n): one comment line. %>
  <%= form_field :comment, "Comment (optional)", id: "allergy_comment" do |aria| %>
    <%= text_field_tag "allergy[comments][]",
          comment_value,
          id: "allergy_comment",
          autocomplete: "off",
          aria: aria %>
  <% end %>

  <div class="form-actions">
    <%= f.submit "Record allergy",
          name: nil,
          class: "button-primary" %>
    <%= link_to "Back to chart",
          patient_chart_path(@dfn),
          class: "button-secondary no-underline" %>
  </div>
<% end %>
