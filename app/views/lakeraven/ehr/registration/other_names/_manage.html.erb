<%# The other names a patient has used, with Remove and Add (rpms-ux S-REG-12.2,
    S-REG-12.4): ALIAS, PATIENT (2.01).
    Locals: dfn, other_names (RpmsRpc::PatientProfile.aliases), can_edit,
    other_name (an OtherNameEntry for the add form; needed when can_edit). %>
<section
  id="other-names-manage"
  aria-labelledby="other-names-heading"
  class="card flex flex-col gap-4"
>
  <h2
    id="other-names-heading"
    class="text-lg font-semibold"
  >
    Other names
  </h2>
  <p class="hint">
    Names the patient has used before.
    A search by any of them finds the patient.
  </p>
  <% if other_names.empty? %>
    <%= empty_state "No other names on file.", id: "no-other-names" %>
  <% else %>
    <table
      id="other-names"
      class="data-table"
    >
      <caption class="sr-only">Other names</caption>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <% if can_edit %>
            <th scope="col"><span class="sr-only">Actions</span></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% other_names.each do |row| %>
          <tr data-other-name="<%= row[:ien] %>">
            <td><%= row[:name] %></td>
            <% if can_edit %>
              <td>
                <%= button_to "Remove #{row[:name]}",
                      registration_remove_patient_other_name_path(dfn, row[:ien]),
                      method: :post,
                      class: "button-secondary",
                      form: { id: "remove-other-name-#{row[:ien]}" } %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if can_edit %>
    <%= form_errors other_name,
          "The other name was not added.",
          id: "other-name-errors" %>
    <%= form_with scope: :other_name,
          url: registration_patient_other_names_path(dfn),
          method: :post,
          local: true,
          id: "other-name-form",
          class: "flex flex-col gap-4" do |f| %>
      <%= form_field :name, "Add an other name (LAST,FIRST MIDDLE)", form: f, error: other_name.errors[:name].first do |aria| %>
        <%= f.text_field :name,
              value: other_name.name,
              required: true,
              autocomplete: "off",
              aria: aria %>
      <% end %>
      <%= f.submit "Add the name",
            class: "button-primary self-start" %>
    <% end %>
  <% end %>
</section>
