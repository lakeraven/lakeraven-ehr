<% page_title "Edit address and phones", @record[:name], "Registration" %>

<%= page_header "Edit address and phones",
      [ @record[:name],
        "RPMS checks each change before it is saved." ] %>

<%= flash_alert id: "address-alert" %>

<%= site_settings_unavailable_alert @address,
      id: "address-settings-unavailable" %>

<%= form_errors @address,
      "The address and phones were not saved.",
      id: "address-errors" %>

<%= form_with scope: :address,
      url: registration_patient_address_path(params[:dfn]),
      method: :patch,
      local: true,
      id: "address-form",
      class: "card flex flex-col gap-4" do |f| %>
  <fieldset class="flex flex-col gap-4">
    <legend>Mailing address</legend>
    <%# STREET ADDRESS [LINE 1], [LINE 2], [LINE 3]: PATIENT (2) fields .111, .112, .113. %>
    <% [ [ :address_line1, "Street address" ],
         [ :address_line2, "Street address, line 2 (optional)" ],
         [ :address_line3, "Street address, line 3 (optional)" ] ].each do |field, label| %>
      <%= form_field field,
            site_field_label(@address, field, label),
            form: f,
            error: @address.errors[field].first do |aria| %>
        <%= f.text_field field,
              value: @address.public_send(field),
              autocomplete: "off",
              required: @address.required_by_site?(field),
              aria: aria %>
      <% end %>
    <% end %>
    <div class="flex flex-wrap gap-4">
      <%# CITY, PATIENT (2) field .114. %>
      <%= form_field :city,
            site_field_label(@address, :city, "City"),
            form: f,
            error: @address.errors[:city].first do |aria| %>
        <%= f.text_field :city,
              value: @address.city,
              autocomplete: "off",
              required: @address.required_by_site?(:city),
              aria: aria %>
      <% end %>
      <%# STATE, PATIENT (2) field .115. %>
      <%= form_field :state,
            site_field_label(@address, :state, "State"),
            form: f,
            error: @address.errors[:state].first do |aria| %>
        <%= f.select :state,
              options_for_select(@states, @address.state),
              { include_blank: "Choose a state" },
              required: @address.required_by_site?(:state),
              aria: aria %>
      <% end %>
      <%# ZIP CODE, PATIENT (2) field .116 (ZIP+4 .1112), filed by AG's PTZP^AGGUL2. %>
      <%= form_field :zip,
            site_field_label(@address, :zip, "Zip code"),
            form: f,
            hint: "5 or 9 digits.",
            error: @address.errors[:zip].first do |aria| %>
        <%= f.text_field :zip,
              value: @address.zip,
              inputmode: "numeric",
              autocomplete: "off",
              required: @address.required_by_site?(:zip),
              aria: aria %>
      <% end %>
    </div>
    <%# DATE TO of the old address and ADDRESS DATE FROM of the new one: PREVIOUS MAIL ADDRESSES (9000001.83) .12, IHS PATIENT (9000001) 7911. %>
    <%= form_field :moved_on,
          "Date they moved",
          form: f,
          hint: "Used when the street address, city, state, zip code or home phone changes. The old address is kept, ending on this date.",
          error: @address.errors[:moved_on].first do |aria| %>
      <%= f.date_field :moved_on,
            value: @address.moved_on&.iso8601,
            max: Lakeraven::EHR::SiteDate.today.iso8601,
            aria: aria %>
    <% end %>
  </fieldset>

  <fieldset class="flex flex-wrap gap-4">
    <legend>Phones and email</legend>
    <%# PHONE NUMBER [RESIDENCE], [WORK]: PATIENT (2) .131, .132. OTHER PHONE, CURRENT EMAIL ADDRESS: IHS PATIENT (9000001) 1801, 1802. %>
    <% [ [ :phone_home, "Home phone (optional)", :telephone_field ],
         [ :phone_work, "Work phone (optional)", :telephone_field ],
         [ :phone_other, "Other phone (optional)", :telephone_field ],
         [ :email, "Email (optional)", :email_field ] ].each do |field, label, input| %>
      <%= form_field field,
            site_field_label(@address, field, label),
            form: f,
            error: @address.errors[field].first do |aria| %>
        <%= f.public_send input,
              field,
              value: @address.public_send(field),
              autocomplete: "off",
              required: @address.required_by_site?(field),
              aria: aria %>
      <% end %>
    <% end %>
  </fieldset>

  <p>
    The cell phone is not changed here.
    RPMS's registration package keeps no cell phone field to edit.
  </p>

  <div class="flex gap-4">
    <%= f.submit "Save address and phones",
          class: "button-primary self-start" %>
    <%= link_to "Cancel",
          registration_patient_path(params[:dfn]),
          class: "button-secondary" %>
  </div>
<% end %>
