<% page_title "Edit a modifier", "Setup" %>

<%= page_header "Edit an eligibility modifier",
      "Type #{@modifier[:type]}: #{Lakeraven::EHR::RegistrationSetupGateway.type_label(@modifier[:type])}." %>

<%= flash_alert id: "eligibility-modifier-alert" %>

<%= form_with url: registration_setup_eligibility_modifier_path(@modifier[:ien]),
      method: :post,
      local: true,
      id: "eligibility-modifier-form",
      class: "card flex flex-col gap-4" do %>
  <%= render "name_field", name: @name %>
  <%= submit_tag "Save the modifier",
        class: "button-primary self-start" %>
<% end %>

<p class="mt-6">
  <%= link_to "Back to the modifiers",
        registration_setup_eligibility_modifiers_path %>
</p>
