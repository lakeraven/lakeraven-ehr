<% page_title "Register a new patient" %>

<%= page_header "Register a new patient",
      "RPMS checks for a patient already on file before anything is saved." %>

<%= flash_alert %>

<%= form_errors @registration,
      "The registration was not saved.",
      id: "registration-errors" %>

<%= form_with scope: :registration,
      url: registration_patients_path,
      method: :post,
      local: true,
      authenticity_token: form_authenticity_token,
      id: "registration-form",
      class: "card flex flex-col gap-4" do |f| %>
  <%= hidden_field_tag :submission_id,
        @submission_id %>
  <%= form_field :name, "Name (LAST,FIRST MIDDLE)", form: f do |aria| %>
    <%= f.text_field :name,
          value: @registration.name,
          required: true,
          autocomplete: "off",
          aria: aria %>
  <% end %>

  <%= choice_list f,
        :sex,
        legend: "Sex",
        choices: [ [ "F", "Female" ], [ "M", "Male" ] ],
        selected: @registration.sex,
        inline: true %>

  <%= form_field :dob, "Date of birth", form: f do |aria| %>
    <%= f.date_field :dob,
          value: @registration.dob,
          required: true,
          aria: aria %>
  <% end %>

  <%= form_field :ssn, "Social security number", form: f do |aria| %>
    <%= f.text_field :ssn,
          value: @registration.ssn,
          inputmode: "numeric",
          autocomplete: "off",
          aria: aria %>
  <% end %>

  <%= form_field :no_ssn_reason, "Or, the reason there is none", form: f do |aria| %>
    <%= f.select :no_ssn_reason,
          Lakeraven::EHR::PatientRegistration::NO_SSN_REASONS.map { |code, label| [ label, code ] },
          { include_blank: true, selected: @registration.no_ssn_reason },
          aria: aria %>
  <% end %>

  <%# TRIBE OF MEMBERSHIP, PATIENT (9000001) field 1108. %>
  <%= lookup_field f,
        :tribe_ien,
        legend: "Tribe of membership",
        search: :tribe_search,
        search_label: "Tribe name starts with",
        find_label: "Find tribe",
        find_url: registration_new_patient_path,
        choices: @tribes.map { |tribe| [ tribe[:ien], tribe[:name], { tribe: tribe[:ien] } ] },
        selected: @registration.tribe_ien,
        chosen_text: "Tribe chosen." %>

  <%# CURRENT COMMUNITY, PATIENT (9000001) field 1118. %>
  <%= lookup_field f,
        :community_ien,
        legend: "Community of residence",
        search: :community_search,
        search_label: "Community name starts with",
        find_label: "Find community",
        find_url: registration_new_patient_path,
        choices: @communities.map { |community| [ community[:ien], "#{community[:name]}, #{community[:county]}, #{community[:state]}", { community: community[:ien] } ] },
        selected: @registration.community_ien,
        chosen_text: "Community chosen." %>

  <%= f.submit "Register",
        class: "button-primary self-start" %>
<% end %>
