<% page_title "Registration not confirmed" %>

<%= page_header "The registration was not confirmed" %>

<%= alert_box :error,
      "RPMS did not say whether #{@registration.name} was registered.",
      "The patient may already be on file, so do not register them again yet.",
      id: "outcome-unknown" %>

<p class="mt-6">
  <%= button_to "Search for #{@registration.name}",
        registration_search_patients_path,
        params: { q: @registration.name, dob: @registration.dob&.iso8601 },
        id: "search-after-unknown",
        class: "button-primary" %>
</p>
