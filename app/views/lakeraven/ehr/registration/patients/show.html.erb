<% content_for :title, "#{@patient[:name]} | Registration | Lakeraven EHR" %>

<div class="page-header">
  <h1><%= @patient[:name] %></h1>
  <p>
    Registration
  </p>
</div>

<dl
  id="registration"
  class="card grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2"
>
  <dt>Health record number</dt>
  <dd data-field="hrn"><%= @patient[:mrn].presence || "None at this facility" %></dd>
  <dt>Date of birth</dt>
  <dd data-field="dob"><%= @patient[:dob]&.strftime("%b %-d, %Y") %></dd>
  <dt>Sex</dt>
  <dd data-field="sex"><%= @patient[:sex] %></dd>
</dl>

<p class="mt-6">
  <%= link_to "Back to search", registration_patients_path %>
</p>
