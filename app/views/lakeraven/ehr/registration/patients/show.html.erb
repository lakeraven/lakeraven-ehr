<% page_title "#{@patient[:name]} | Registration" %>

<%= page_header @patient[:name], "Registration" %>

<%= flash_alert id: "registration-alert" %>

<% if flash[:notice].present? %>
  <%= alert_box :notice,
        flash[:notice],
        id: "registration-notice" %>
<% end %>

<% if @registered_hrn.present? %>
  <%= alert_box :notice,
        "Registered.",
        "Health record number #{@patient[:mrn].presence || @registered_hrn}.",
        id: "registered" %>
<% end %>

<%= patient_summary @patient, id: "registration" %>

<% if @checks %>
  <%= render "lakeraven/ehr/registration/patients/missing_items",
        checks: @checks %>
<% end %>

<% if capability?("registration.search") && @record.nil? %>
  <%= alert_box :error,
        "RPMS did not send the rest of this patient's registration.",
        "Open the patient again in a minute.",
        id: "record-unavailable" %>
<% end %>

<% if @record %>
  <% can_edit = capability?("patient.register") %>
  <section
    id="demographics"
    aria-labelledby="demographics-heading"
    class="card mt-6"
  >
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="demographics-heading">Demographics</h2>
      <% if can_edit %>
        <%= link_to "Edit demographics",
              registration_edit_patient_demographics_path(params[:dfn]),
              id: "edit-demographics" %>
      <% end %>
    </div>
    <dl class="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2">
      <%# NAME, PATIENT (2) field .01. %>
      <dt>Name</dt>
      <dd data-field="name"><%= @record[:name] %></dd>
      <%# DATE OF BIRTH, PATIENT (2) field .03. %>
      <dt>Date of birth</dt>
      <dd data-field="dob"><%= @record[:dob]&.strftime("%b %-d, %Y") || @record[:dob_text] %></dd>
      <%# SEX, PATIENT (2) field .02. %>
      <dt>Sex</dt>
      <dd data-field="sex"><%= @record.dig(:sex, :external)&.capitalize %></dd>
      <%# SOCIAL SECURITY NUMBER, PATIENT (2) field .09: the last four only, as AG's own look-up shows it. %>
      <dt>Social security number</dt>
      <dd data-field="ssn"><%= @record[:ssn].present? ? "XXX-XX-#{@record[:ssn].to_s[-4..]}" : "None on file" %></dd>
      <%# MARITAL STATUS, PATIENT (2) field .05. %>
      <dt>Marital status</dt>
      <dd data-field="marital_status"><%= @record.dig(:marital_status, :external)&.capitalize || "Not recorded" %></dd>
      <%# RELIGIOUS PREFERENCE, PATIENT (2) field .08. %>
      <dt>Religion</dt>
      <dd data-field="religion"><%= @record.dig(:religion, :external)&.titleize || "Not recorded" %></dd>
      <%# PLACE OF BIRTH [CITY] and [STATE], PATIENT (2) fields .092 and .093. %>
      <dt>Place of birth</dt>
      <dd data-field="birth_place"><%= [ @record[:birth_city]&.titleize, @record.dig(:birth_state, :external)&.titleize ].compact.join(", ").presence || "Not recorded" %></dd>
      <%# EMPLOYER and EMPLOYMENT STATUS, IHS PATIENT (9000001) fields .19 and .21. %>
      <dt>Employer</dt>
      <dd data-field="employer"><%= @record.dig(:employer, :external)&.titleize || "Not recorded" %></dd>
      <dt>Employment status</dt>
      <dd data-field="employment_status"><%= Lakeraven::EHR::PatientDemographics::EMPLOYMENT_STATUSES[@record.dig(:employment_status, :external)] || "Not recorded" %></dd>
    </dl>
  </section>

  <section
    id="address"
    aria-labelledby="address-heading"
    class="card mt-6"
  >
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="address-heading">Address and phones</h2>
      <% if can_edit %>
        <%= link_to "Edit address and phones",
              registration_edit_patient_address_path(params[:dfn]),
              id: "edit-address" %>
      <% end %>
    </div>
    <dl class="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2">
      <%# STREET ADDRESS [LINE 1-3], CITY, STATE, ZIP CODE: PATIENT (2) fields .111-.116. %>
      <dt>Mailing address</dt>
      <dd data-field="mailing_address">
        <% lines = [ @record[:address_line1], @record[:address_line2], @record[:address_line3],
                     [ @record[:city], @record.dig(:state, :external), @record[:zip] ].compact.join(" ").presence ].compact %>
        <% if lines.empty? %>
          None on file
        <% else %>
          <% lines.each do |line| %>
            <span class="block"><%= line %></span>
          <% end %>
        <% end %>
      </dd>
      <%# PHONE NUMBER [RESIDENCE] and [WORK], PATIENT (2) fields .131 and .132. %>
      <dt>Home phone</dt>
      <dd data-field="phone_home"><%= @record[:phone_home] || "None on file" %></dd>
      <dt>Work phone</dt>
      <dd data-field="phone_work"><%= @record[:phone_work] || "None on file" %></dd>
      <%# PHONE NUMBER [CELLULAR], PATIENT (2) field .134: no AG window edits it. %>
      <dt>Cell phone</dt>
      <dd data-field="phone_cell"><%= @record[:phone_cell] || "None on file" %></dd>
      <%# OTHER PHONE and CURRENT EMAIL ADDRESS, IHS PATIENT (9000001) fields 1801 and 1802. %>
      <dt>Other phone</dt>
      <dd data-field="phone_other"><%= @record[:phone_other] || "None on file" %></dd>
      <dt>Email</dt>
      <dd data-field="email"><%= @record[:email] || "None on file" %></dd>
    </dl>
  </section>

  <%= render "lakeraven/ehr/registration/addresses/history",
        history: @address_history %>

  <% if @contacts %>
    <%= render "lakeraven/ehr/registration/contacts/section",
          dfn: params[:dfn],
          contacts: @contacts,
          can_edit: can_edit %>
  <% end %>

  <% unless @languages.nil? %>
    <%= render "lakeraven/ehr/registration/languages/section",
          dfn: params[:dfn],
          languages: @languages,
          can_edit: can_edit %>
  <% end %>

  <% unless @social_status.nil? %>
    <%= render "lakeraven/ehr/registration/social_statuses/section",
          dfn: params[:dfn],
          social_status: @social_status,
          can_edit: can_edit %>
  <% end %>

  <% unless @preferred_name.nil? %>
    <%= render "lakeraven/ehr/registration/preferred_names/section",
          dfn: params[:dfn],
          preferred_name: @preferred_name,
          can_edit: can_edit %>
  <% end %>

  <% unless @race_ethnicity.nil? %>
    <%= render "lakeraven/ehr/registration/race_ethnicities/section",
          dfn: params[:dfn],
          race_ethnicity: @race_ethnicity,
          can_edit: can_edit %>
  <% end %>

  <% if @other_names %>
    <%= render "lakeraven/ehr/registration/other_names/section",
          dfn: params[:dfn],
          other_names: @other_names,
          can_edit: can_edit %>
  <% end %>
<% end %>

<p class="mt-6">
  <% if capability?("patient.register") %>
    <%= link_to "Tribe and eligibility",
          registration_edit_patient_eligibility_path(params[:dfn]),
          id: "edit-eligibility" %>
  <% end %>
  <%= link_to "Coverage",
        registration_patient_coverage_path(params[:dfn]),
        id: "patient-coverage-link" %>
  <% if capability?("scheduling.open") %>
    <%= link_to "Appointments",
          scheduling_patient_appointments_path(params[:dfn]),
          id: "patient-appointments-link" %>
  <% end %>
  <%= link_to "Back to search", registration_patients_path %>
</p>
