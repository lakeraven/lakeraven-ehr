<% page_title "#{@patient[:name]} | Registration" %>

<%= page_header @patient[:name], "Registration" %>

<%= flash_alert id: "registration-alert" %>

<% if @registered_hrn.present? %>
  <%= alert_box :notice,
        "Registered.",
        "Health record number #{@patient[:mrn].presence || @registered_hrn}.",
        id: "registered" %>
<% end %>

<%= patient_summary @patient, id: "registration" %>

<% if @checks %>
  <%= render "lakeraven/ehr/registration/patients/missing_items",
        checks: @checks %>
<% end %>

<p class="mt-6">
  <% if capability?("scheduling.open") %>
    <%= link_to "Appointments",
          scheduling_patient_appointments_path(params[:dfn]),
          id: "patient-appointments-link" %>
  <% end %>
  <%= link_to "Back to search", registration_patients_path %>
</p>
