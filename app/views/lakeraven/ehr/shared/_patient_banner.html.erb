<%# Stays on screen while a long chart scrolls, so the clinician can still
    see which patient they are documenting on.
    One partial on every page with a patient open, the chart included:
    the patient, the controls to change patient, then their allergies as
    one alert. A page with more to say about allergies (the chart) fills
    the alert with content_for :patient_allergies. %>
<div
  id="patient-banner"
  class="sticky top-0 z-20 bg-slate-50"
>
  <% if banner.empty? %>
    <%# No patient open: the bar holds the search (rpms-ux S-CHT-01.7). %>
    <% if patient_search_allowed? %>
      <%= render "lakeraven/ehr/shared/patient_search_form", query: @query %>
    <% end %>
  <% else %>
    <div class="patient-banner__inner">
      <% if banner.notice.present? %>
        <p><%= banner.notice %></p>
      <% end %>

      <% if banner.demographics %>
        <div class="banner">
          <div>
            <h1><%= banner.demographics.name %></h1>
          </div>
          <dl class="demoinfo">
            <div><dt>DOB</dt><dd><%= banner.demographics.dob_text %></dd></div>
            <div><dt>Age</dt><dd><%= banner.demographics.age_text %></dd></div>
            <div><dt>Sex</dt><dd><%= banner.demographics.sex_text %></dd></div>
            <div><dt>MRN / DFN</dt><dd><%= banner.demographics.mrn %></dd></div>
          </dl>
        </div>
      <% end %>

      <div class="patient-banner__actions">
        <%# Another patient can be found without closing this chart (S-CHT-01.9). %>
        <% if patient_search_allowed? %>
          <%= link_to "Switch patient",
                chart_search_path,
                id: "switch-patient" %>
        <% end %>

        <% if banner.show_clear? %>
          <%# URL rather than path: the route helper already includes the engine
              mount, and a root-relative action would be prefixed with it again. %>
          <%= button_to "Clear patient context",
                active_patient_context_url,
                method: :delete %>
        <% end %>
      </div>

      <% if banner.allergies %>
        <%# Red unless RPMS says the patient has none recorded. "Not loaded"
            stays red: an unknown list is never a reassurance. %>
        <div
          class="patient-banner__allergies<%= " patient-banner__allergies--none" if banner.allergies.none_recorded? %>"
          data-allergies-state="<%= banner.allergies.state %>"
          role="note"
          aria-label="Allergies"
        >
          <% if content_for?(:patient_allergies) %>
            <%= yield :patient_allergies %>
          <% else %>
            <span class="patient-banner__allergies-label">Allergies</span>
            <%# Loaded is the names alone. Otherwise #text is "None recorded",
                "Not loaded", or the known names plus the incomplete-list note. %>
            <% if banner.allergies.loaded? %>
              <% banner.allergies.names.each do |name| %>
                <span class="allergy-chip"><%= name %></span>
              <% end %>
            <% else %>
              <span><%= banner.allergies.text %></span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
