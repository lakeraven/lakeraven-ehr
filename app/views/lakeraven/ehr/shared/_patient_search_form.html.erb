<%= form_with url: chart_search_path,
      method: :post,
      local: true,
      id: "patient-search",
      role: "search",
      class: "flex flex-wrap items-center gap-2 px-4 py-2" do %>
  <%= label_tag :patient_search_q,
        "Find a patient",
        class: "sr-only" %>
  <%= text_field_tag :q,
        query,
        id: "patient_search_q",
        required: true,
        autocomplete: "off",
        placeholder: "Name, HRN, date of birth or last 4 of SSN",
        class: "min-w-72 rounded border border-slate-300 px-3 py-2" %>
  <%= submit_tag "Find patient",
        name: nil,
        class: "min-h-9 bg-slate-900 px-4 py-2 text-white hover:bg-slate-700" %>
  <%= link_to "Recent patients",
        chart_search_path,
        id: "recent-patients-link" %>
<% end %>
