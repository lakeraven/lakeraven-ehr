<%# The page's heading, its lede and its actions (ComponentsHelper#page_header).
    Locals: title (String), lede (String, Array of sentences, or nil),
    actions (HTML or nil). %>
<% lede = Array(local_assigns[:lede]).compact_blank %>
<div class="page-header">
  <div>
    <h1><%= title %></h1>
    <% lede.each do |sentence| %>
      <p><%= sentence %></p>
    <% end %>
  </div>
  <% if local_assigns[:actions].present? %>
    <div class="page-header__actions">
      <%= actions %>
    </div>
  <% end %>
</div>
