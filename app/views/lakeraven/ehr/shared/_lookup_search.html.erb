<%# The search row of a lookup field (ComponentsHelper#lookup_field).
    Locals: search (param name), search_label, find_label, find_url,
    find_method. The Find button resubmits the whole form to find_url,
    unvalidated, so what the clerk typed elsewhere is kept. %>
<div class="lookup-search">
  <%= label_tag search,
        search_label,
        class: "sr-only" %>
  <%= text_field_tag search,
        params[search],
        placeholder: search_label,
        autocomplete: "off" %>
  <%= submit_tag find_label,
        name: nil,
        formaction: find_url,
        formmethod: find_method,
        formnovalidate: true,
        class: "button-secondary" %>
</div>
