#!/usr/bin/env sh
# Demo boot for the read-only patient chart (issue #452). Dev-only convenience:
# runs the preflight checks that have bitten us before, then starts the dummy
# app with the exact env the demo needs. Synthetic data only — no PHI.
#
#   test/dummy/bin/demo              # http://localhost:3000/patients/1
#   PORT=3001 test/dummy/bin/demo    # bind and print that port instead
#   test/dummy/bin/demo -b 0.0.0.0   # if showing from another device
#
# Set PORT to choose the listen port. A single-dash argument whose option
# letters include a lowercase p, and --port including unique prefixes, are
# refused so they cannot override that check. A -b/--binding value containing
# "://" is refused too; set the host with a plain -b HOST. BINDING containing
# "://" is refused as well; set a plain host (the port comes from PORT).
set -e
cd "$(dirname "$0")/.."

# PORT selects the listen port and the URL printed below. Default is 3000.
# All digits, 1..65535. Leading zeros are accepted and normalized (08 is not octal).
PORT="${PORT:-3000}"
case "$PORT" in
  *[!0-9]*)
    printf 'PORT must be an integer from 1 to 65535 (got %s)\n' "$PORT" >&2
    exit 1
    ;;
esac
port_num=$PORT
while [ "$port_num" != "${port_num#0}" ]; do
  port_num=${port_num#0}
done
if [ -z "$port_num" ] || [ "${#port_num}" -gt 5 ] || [ "$port_num" -gt 65535 ]; then
  printf 'PORT must be an integer from 1 to 65535 (got %s)\n' "$PORT" >&2
  exit 1
fi
PORT=$port_num
export PORT

# Rails would append a later -p / --port after our guarded -p "$PORT" and bind
# the unguarded one. Thor splits a single-dash cluster into one short option
# per letter, so refuse any whose option letters include a lowercase p (-p,
# -pN, -p=N, -p+N, -dp, -Cp, -pd, ...). When the argument is only letters,
# every letter is an option letter; otherwise only the first character is,
# and the rest is an attached value. Unique --port prefixes (--po, --por)
# are refused too; --p also matches --pid, so it is left alone. Negated
# --no-/--skip- forms are refused because Thor maps them to --port. Thor
# rewrites "_" to "-" in switch names, so the option name (the part before
# "=") is matched after that same rewrite (--no_port, --skip_port=N, --no_po,
# ...). Capital -P is the pidfile and is forwarded.
# A -b/--binding value containing "://" is a URI (ssl://, tcp://, unix://, or
# any other scheme). Puma listens on that URI instead of PORT. Refuse
# -b VALUE (the value is the next argument), -bVALUE, -b=VALUE, --binding
# VALUE, and --binding=VALUE, plus underscore spellings of the long name.
# A letter cluster ending in b (-db, -Cb) is the same as -b: Thor splits it
# and the next argument is the binding. Thor maps only the full --binding
# switch (--bind and other shorter prefixes do not set it). A plain host
# (-b 127.0.0.1, --binding=0.0.0.0) is forwarded unchanged. BINDING containing
# "://" is refused the same way, even when -b is also passed: Rails reads
# BINDING when no -b is given, and Puma would listen on that URI instead of
# PORT. A plain host in BINDING is forwarded unchanged. The listen port
# comes only from PORT.
prev=
for arg in "$@"; do
  case "$prev" in
    -b|--binding)
      case "$arg" in
        *://*)
          printf 'Set the host with a plain -b HOST; the port comes from PORT (refusing %s).\n' "$arg" >&2
          exit 1
          ;;
      esac
      ;;
  esac

  # Option name only: Thor's tr("_", "-") does not touch the value after "=".
  opt=${arg%%=*}
  while [ "$opt" != "${opt%%_*}" ]; do
    opt=${opt%%_*}-${opt#*_}
  done

  prev=
  case "$opt" in
    --port|--po|--por|\
    --no-port|--skip-port|\
    --no-po|--no-por|\
    --skip-po|--skip-por)
      printf 'Set the listen port with PORT instead of %s (for example PORT=3001 test/dummy/bin/demo).\n' "$arg" >&2
      exit 1
      ;;
    --binding)
      case "$arg" in
        *://*)
          printf 'Set the host with a plain -b HOST; the port comes from PORT (refusing %s).\n' "$arg" >&2
          exit 1
          ;;
        *=*)
          ;;
        *)
          prev=--binding
          ;;
      esac
      ;;
    --*)
      ;;
    -*)
      body=${arg#-}
      letters=$body
      case "$letters" in
        *[!A-Za-z]*)
          letters=${letters%"${letters#?}"}
          ;;
      esac
      case "$letters" in
        *p*)
          printf 'Set the listen port with PORT instead of %s (for example PORT=3001 test/dummy/bin/demo).\n' "$arg" >&2
          exit 1
          ;;
      esac
      case "$arg" in
        -b*://*)
          printf 'Set the host with a plain -b HOST; the port comes from PORT (refusing %s).\n' "$arg" >&2
          exit 1
          ;;
      esac
      # Bare -b, or a letters-only cluster whose last option is -b, takes the
      # next argument as the host. -b=HOST and -bHOST already carry a value.
      case "$body" in
        *[!A-Za-z]*)
          ;;
        *b)
          prev=-b
          ;;
      esac
      ;;
  esac
done

# BINDING is the host Rails uses when -b is absent. A value containing "://"
# is a URI and would ignore PORT, so refuse it even if -b is also passed.
# A plain host is left unchanged for Rails.
case "$BINDING" in
  *://*)
    printf 'Set BINDING to a plain host; the port comes from PORT (refusing %s).\n' "$BINDING" >&2
    exit 1
    ;;
esac

# 1. Postgres must be up — dev-mode CheckPending middleware hits the DB on
#    every request, so a down Postgres 500s the whole demo.
if ! pg_isready -q; then
  echo "Postgres is not accepting connections. Try: brew services start postgresql" >&2
  exit 1
fi

# 2. Name a holder with lsof when we can. Empty lsof output is not evidence
#    the port is free: lsof may be missing, or the listener may be owned by
#    another user (for example docker-proxy) and invisible to us. Never signal
#    a holder. "Free" is decided only by a successful bind probe below.
if command -v lsof >/dev/null 2>&1; then
  listeners=$(lsof +c 0 -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)
  holders=$(printf '%s\n' "$listeners" | awk '
    NR == 1 && $1 == "COMMAND" { next }
    $2 ~ /^[0-9][0-9]*$/ && !seen[$2] { seen[$2] = 1; print $2, $1 }
  ' || true)
  if [ -n "$holders" ]; then
    printf 'Port %s is already in use:\n' "$PORT" >&2
    printf '%s\n' "$holders" | awk '{ printf "PID %s command %s\n", $1, $2 }' >&2
    printf '%s\n' "choose another port, e.g. PORT=3001 test/dummy/bin/demo" >&2
    exit 1
  fi
fi

# Positive evidence only: exit 0 when 0.0.0.0 and 127.0.0.1 bind, and ::1 binds
# or is n/a (EADDRNOTAVAIL / EAFNOSUPPORT). Exit 10 when the port is busy.
# Anything else is a probe failure and the shell fails closed. On macOS/BSD,
# TCPServer sets SO_REUSEADDR, so 0.0.0.0 can bind while 127.0.0.1 is held.
if ! command -v ruby >/dev/null 2>&1; then
  printf 'Could not check whether port %s is free; the bind probe could not run: ruby was not found on PATH.\n' "$PORT" >&2
  exit 1
fi
probe_rc=0
probe_err=$(ruby -rsocket -e '
port = Integer(ARGV[0])

def bind_result(host, port)
  server = TCPServer.new(host, port)
  server.close
  "ok"
rescue Errno::EADDRINUSE
  "busy"
rescue Errno::EADDRNOTAVAIL, Errno::EAFNOSUPPORT
  if host == "::1"
    "na"
  else
    warn format("bind probe failed on %s: %s: %s", host, $!.class, $!.message)
    exit 1
  end
rescue StandardError
  warn format("bind probe failed on %s: %s: %s", host, $!.class, $!.message)
  exit 1
end

result = bind_result("0.0.0.0", port)
exit 10 if result == "busy"
unless result == "ok"
  warn "bind probe failed on 0.0.0.0"
  exit 1
end

result = bind_result("127.0.0.1", port)
exit 10 if result == "busy"
unless result == "ok"
  warn "bind probe failed on 127.0.0.1"
  exit 1
end

result = bind_result("::1", port)
exit 10 if result == "busy"
exit 0 if result == "ok" || result == "na"

warn "bind probe failed on ::1"
exit 1
' "$PORT" 2>&1) || probe_rc=$?

if [ "$probe_rc" -eq 10 ]; then
  printf 'Port %s is already in use, but the holder could not be identified (lsof is missing or cannot see it, e.g. owned by another user such as docker-proxy).\n' "$PORT" >&2
  printf 'Try: sudo lsof -nP -iTCP:%s -sTCP:LISTEN\n' "$PORT" >&2
  printf '%s\n' "choose another port, e.g. PORT=3001 test/dummy/bin/demo" >&2
  exit 1
fi
if [ "$probe_rc" -ne 0 ]; then
  printf 'Could not check whether port %s is free; the bind probe failed' "$PORT" >&2
  if [ -n "$probe_err" ]; then
    printf ': %s\n' "$probe_err" >&2
  else
    printf ' (exit status %s).\n' "$probe_rc" >&2
  fi
  exit 1
fi

# Stale pidfile only after the probe proves the port is free.
rm -f tmp/pids/server.pid

# 3. A stray RPMS_RPC_PATH flips the Gemfile to a path source and bundler
#    rejects the lockfile at boot — make sure it is unset.
unset RPMS_RPC_PATH

# 4. Both flags are required, and both are honored ONLY in development:
#    SPIKE_MOCK_RPC=1  seeds the in-memory RPMS mock (else 404/empty chart)
#    CHART_DEMO_OPEN=1 dev-only auth bypass (else 401 without a token)
echo "Starting demo server -> http://localhost:$PORT/patients/1"
exec env RAILS_ENV=development CHART_DEMO_OPEN=1 SPIKE_MOCK_RPC=1 bin/rails server -p "$PORT" "$@"
