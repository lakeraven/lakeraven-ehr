#!/usr/bin/env sh
# Demo boot for the read-only patient chart (issue #452). Dev-only convenience:
# runs the preflight checks that have bitten us before, then starts the dummy
# app with the exact env the demo needs. Synthetic data only — no PHI.
#
#   test/dummy/bin/demo            # http://localhost:3000/patients/1
#   PORT=3001 test/dummy/bin/demo  # when something else holds 3000
#   test/dummy/bin/demo -b 0.0.0.0 # if showing from another device
set -e
cd "$(dirname "$0")/.."

# 1. The port must be free. This script never kills what holds it: on a
#    workstation that is often something unrelated. It names the owner and
#    stops; choose another port with PORT, or stop that process yourself.
PORT="${PORT:-3000}"
case "$PORT" in
  ''|*[!0-9]*)
    echo "PORT must be a number, got: $PORT" >&2
    exit 1
    ;;
esac
OWNER=$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true)
if [ -n "$OWNER" ]; then
  echo "Port $PORT is in use. Not starting, and not stopping its owner:" >&2
  echo "$OWNER" >&2
  echo "Use another port (PORT=3001 $0), or stop that process yourself." >&2
  exit 1
fi

# 2. Postgres must be up — dev-mode CheckPending middleware hits the DB on
#    every request, so a down Postgres 500s the whole demo.
if ! pg_isready -q; then
  echo "Postgres is not accepting connections. Try: brew services start postgresql" >&2
  exit 1
fi

# 3. A pidfile left by a server that is gone blocks the boot. Remove it only
#    when its process is not running.
PIDFILE=tmp/pids/server.pid
if [ -f "$PIDFILE" ] && ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  rm -f "$PIDFILE"
fi

# 4. A stray RPMS_RPC_PATH flips the Gemfile to a path source and bundler
#    rejects the lockfile at boot — make sure it is unset.
unset RPMS_RPC_PATH

# 5. Both flags are required, and both are honored ONLY in development:
#    SPIKE_MOCK_RPC=1  seeds the in-memory RPMS mock (else 404/empty chart)
#    CHART_DEMO_OPEN=1 dev-only auth bypass (else 401 without a token)
echo "Starting demo server -> http://localhost:$PORT/patients/1"
exec env RAILS_ENV=development CHART_DEMO_OPEN=1 SPIKE_MOCK_RPC=1 bin/rails server -p "$PORT" "$@"
